{%- liquid
  assign hero_title = ''
  if collection.handle == 'the-legacy-collection'
    assign hero_title = 'A LEGACY IS BUILT.'
  elsif collection.handle == 'lgcy-glasses'
    assign hero_title = 'LGCY EYEWEAR'
  elsif collection.handle == 'all'
    assign hero_title = 'LGCYCLOTHING'
  endif
-%}
{%- if hero_title != blank -%}
{%- if collection.handle == 'the-legacy-collection' -%}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600&display=swap" rel="stylesheet">
{%- endif -%}
<div id="hero-title-collection" style="
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  pointer-events: none;
  text-align: center;
  width: 90vw;
  max-width: 100%;
">
  <h1 style="
    font-family: 'Inter', Helvetica, Arial, sans-serif;
    font-size: clamp(28px, 8vw, 77px);
    font-weight: 900;
    letter-spacing: -3px;
    color: #ffffff;
    margin: 0;
    padding: 0;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  ">{{ hero_title }}</h1>
  {%- if collection.handle == 'the-legacy-collection' -%}
  <p id="hero-subtitle-collection" style="
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(15px, 1.8vw, 21px);
    color: #ffffff;
    margin: 4px 0 0;
    padding: 0;
    line-height: 1.35;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.75), 0 1px 4px rgba(0, 0, 0, 0.9);
  ">&ldquo;Clothing made with intention, for people building something of their own.&rdquo;</p>
  {%- endif -%}
</div>
<style>
  @media (max-width: 768px) {
    #hero-title-collection h1 {
      font-size: clamp(20px, 7vw, 45px) !important;
      letter-spacing: -1px !important;
      white-space: nowrap;
    }
    #hero-subtitle-collection {
      font-size: clamp(13px, 4vw, 20px) !important;
      margin-top: 3px !important;
    }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Collection Hero Title",
  "tag": "div"
}
{% endschema %}
