{{ 'lgcy-about.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">

<section class="lgcy-about" aria-label="About LGCYCLOTHING">
  <div class="lgcy-about__blob lgcy-about__blob--1" aria-hidden="true"></div>
  <div class="lgcy-about__blob lgcy-about__blob--2" aria-hidden="true"></div>

  <div class="lgcy-about__inner">
    <p class="lgcy-about__eyebrow lgcy-about__fade" style="--d: 0s">LGCYCLOTHING &middot; Est. 2026</p>
    <h1 class="lgcy-about__title lgcy-about__fade" style="--d: 0.08s">We build legacies,<br>not just clothes.</h1>
    <p class="lgcy-about__body lgcy-about__fade" style="--d: 0.16s">
      Made for those who move with intention — worn by the visionary, made for the legacy.
    </p>

    <div class="lgcy-about__card lgcy-about__fade" style="--d: 0.24s">
      <div class="lgcy-about__values">
        <div class="lgcy-about__value">
          <span class="lgcy-about__value-word">Faith</span>
          <span class="lgcy-about__value-desc">Belief before proof</span>
        </div>
        <div class="lgcy-about__value">
          <span class="lgcy-about__value-word">Purpose</span>
          <span class="lgcy-about__value-desc">Deliberate in every detail</span>
        </div>
        <div class="lgcy-about__value">
          <span class="lgcy-about__value-word">Legacy</span>
          <span class="lgcy-about__value-desc">What you leave behind</span>
        </div>
      </div>

      <a href="{{ routes.all_products_collection_url }}" class="lgcy-about__cta">
        <span>Shop The Collection</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Page",
  "tag": "div"
}
{% endschema %}
