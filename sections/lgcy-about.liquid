{{ 'lgcy-about.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">

<section class="lgcy-about" aria-label="About LGCYCLOTHING">
  <div class="lgcy-about__blob lgcy-about__blob--1" aria-hidden="true"></div>
  <div class="lgcy-about__blob lgcy-about__blob--2" aria-hidden="true"></div>

  <div class="lgcy-about__story lgcy-about__fade" style="--d: 0s">
    <h2 class="lgcy-about__story-title">Legacy.</h2>

    <div class="lgcy-about__image lgcy-about__fade" style="--d: 0.05s">
      {%- assign about_img = 'https://cdn.shopify.com/s/files/1/0688/4537/1578/files/copy_BFEC219A-260A-49A6-833D-B9D90AC4307A.jpg?v=1789580904' -%}
      <img
        src="{{ about_img }}&width=900"
        srcset="
          {{ about_img }}&width=480 480w,
          {{ about_img }}&width=720 720w,
          {{ about_img }}&width=960 960w,
          {{ about_img }}&width=1200 1200w
        "
        sizes="(min-width: 990px) 560px, 100vw"
        width="2632"
        height="3511"
        style="display:block;width:100%;height:auto;"
        alt="LGCYCLOTHING — behind the scenes"
        loading="lazy"
      >
    </div>

    <p class="lgcy-about__story-body">LGCYCLOTHING is quiet confidence, made real.</p>
    <p class="lgcy-about__story-body">Every piece starts with a simple question: does this look right. Just clothing made the way it should be worn — clean silhouettes, heavyweight fabric, typography that carries weight without needing to shout. This is what good looks like — restrained, deliberate, built to last.</p>
    <p class="lgcy-about__story-body">This is for the ones who move with purpose. People who understand that presence comes from the details. The fit that sits right. The fabric that holds its shape. The quiet certainty of knowing exactly what you stand for.</p>
    <p class="lgcy-about__story-body">A legacy isn't built in a single moment — it's built piece by piece, drop by drop, decision by decision. Every release adds to the story. Every piece carries the same standard forward.</p>
    <p class="lgcy-about__story-body">Every drop is a chapter, not a finished statement. This is where LGCYCLOTHING begins — one piece, one decision, one release at a time, building toward something bigger than any single drop.</p>
    <p class="lgcy-about__story-body">This is the legacy. And it's only getting started.</p>
    <p class="lgcy-about__story-body lgcy-about__story-body--close">Welcome to LGCYCLOTHING. The legacy starts now.</p>

    <a href="{{ routes.all_products_collection_url }}" class="lgcy-about__cta">
      <span>Shop The Collection</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "About Page",
  "tag": "div"
}
{% endschema %}
