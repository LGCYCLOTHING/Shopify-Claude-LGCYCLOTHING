{%- comment -%}
  Condensed Lookbook preview, shown only on the Legacy (clothing) collection
  page — links through to the full /pages/lookbook. Gated on collection.handle
  since this section lives in the shared templates/collection.json used by
  every collection.
{%- endcomment -%}

{%- if collection.handle == 'the-legacy-collection' -%}
<style>
  .lgcy-lookbook-teaser {
    background: #ffffff;
    padding: 60px 20px;
  }
  .lgcy-lookbook-teaser-head {
    max-width: 1200px;
    margin: 0 auto 28px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .lgcy-lookbook-teaser-title {
    font-family: 'Inter', Helvetica, Arial, sans-serif;
    font-weight: 900;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }
  .lgcy-lookbook-teaser-link {
    font-family: 'Inter', Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .lgcy-lookbook-teaser-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .lgcy-lookbook-teaser-grid img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  @media screen and (max-width: 749px) {
    .lgcy-lookbook-teaser-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<div class="lgcy-lookbook-teaser">
  <div class="lgcy-lookbook-teaser-head">
    <h2 class="lgcy-lookbook-teaser-title">{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.link | default: '/pages/lookbook' }}" class="lgcy-lookbook-teaser-link">{{ section.settings.link_label }}</a>
  </div>
  <div class="lgcy-lookbook-teaser-grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <img
          src="{{ block.settings.image | img_url: '800x' }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          {{ block.shopify_attributes }}
        >
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook teaser",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lookbook."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View Lookbook"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Lookbook teaser",
      "category": "Main",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
