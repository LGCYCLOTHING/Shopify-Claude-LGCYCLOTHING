<script>
(function() {
  var crumbs = null;

  // Same breadcrumb trail previously built in layout/theme.liquid — moved
  // here since it now lands next to the trust row instead of the (removed)
  // editorial eyebrow.
  function buildCrumbs() {
    var titleEl = document.querySelector('.rp-title, h1');
    var titleText = (titleEl && titleEl.textContent.trim()) ||
                    document.title.split('|')[0].trim();

    var collectionHandle = null;
    var pathMatch = window.location.pathname.match(/\/collections\/([^/]+)\/products\//);
    if (pathMatch) {
      collectionHandle = pathMatch[1];
    } else if (document.referrer) {
      try {
        var refUrl = new URL(document.referrer);
        if (refUrl.host === window.location.host) {
          var refMatch = refUrl.pathname.match(/^\/collections\/([^/]+)\/?$/);
          if (refMatch) collectionHandle = refMatch[1];
        }
      } catch (e) {}
    }

    var collectionLabel = 'All';
    var collectionHref = '/collections/all';
    if (collectionHandle) {
      collectionHref = '/collections/' + collectionHandle;
      collectionLabel = collectionHandle
        .split('-')
        .map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1); })
        .join(' ');
    }

    var nav = document.createElement('nav');
    nav.className = 'lgcy-breadcrumbs lgcy-breadcrumbs--trust';
    nav.setAttribute('aria-label', 'Breadcrumb');
    nav.innerHTML =
      '<a href="/">Home</a>' +
      '<span class="lgcy-breadcrumbs__sep" aria-hidden="true">&rsaquo;</span>' +
      '<a class="lgcy-breadcrumbs__collection" href=""></a>' +
      '<span class="lgcy-breadcrumbs__sep" aria-hidden="true">&rsaquo;</span>' +
      '<span class="lgcy-breadcrumbs__current"></span>';
    var collectionLink = nav.querySelector('.lgcy-breadcrumbs__collection');
    collectionLink.href = collectionHref;
    collectionLink.textContent = collectionLabel;
    nav.querySelector('.lgcy-breadcrumbs__current').textContent = titleText;
    return nav;
  }

  function reposition() {
    var trust = document.querySelector('.lgcy-trust');
    if (!trust || !trust.parentNode) return false;

    // Move trust next to the feed first (if it exists yet), then pull
    // "You May Also Like" in right after trust so it lands above the feed
    // instead of below it. The breadcrumb insertion below always targets
    // trust's current position, so it has to run after trust has settled
    // into its final spot.
    var feed = document.querySelector('#insta-feed, .instafeed-shopify');
    if (feed && feed.parentNode) {
      if (trust.nextElementSibling !== feed) {
        feed.parentNode.insertBefore(trust, feed);
      }
      var cards = document.querySelector('.rp-cards-section');
      if (cards && trust.nextElementSibling !== cards) {
        feed.parentNode.insertBefore(cards, feed);
      }
    }

    if (!crumbs) crumbs = buildCrumbs();
    if (trust.previousElementSibling !== crumbs) {
      trust.parentNode.insertBefore(crumbs, trust);
    }

    return !!feed;
  }
  var attempts = 0, max = 60;
  var timer = setInterval(function() {
    attempts++;
    if (reposition() || attempts >= max) clearInterval(timer);
  }, 250);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', reposition);
  } else {
    reposition();
  }
})();
</script>

<style>
  .rp-header-hidden { transform: translateY(-100%) !important; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important; }
  .rp-header-visible { transform: translateY(0) !important; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important; }
</style>

<script>
(function() {
  function getHeader() {
    return (
      document.querySelector('.shopify-section-group-header-group') ||
      document.querySelector('#shopify-section-header') ||
      document.querySelector('sticky-header') ||
      document.querySelector('.header-wrapper') ||
      document.querySelector('header[role="banner"]') ||
      document.querySelector('header')
    );
  }
  var header = getHeader();
  if (!header) return;
  var style = window.getComputedStyle(header);
  if (style.position === 'static') { header.style.position = 'relative'; }
  header.style.transition = 'transform 0.35s cubic-bezier(0.4, 0, 0.2, 1)';
  header.style.zIndex = '1000';
  var lastScrollY = window.scrollY, ticking = false, SCROLL_THRESHOLD = 80, isHidden = false;
  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(function() {
        var currentY = window.scrollY;
        var diff = currentY - lastScrollY;
        if (currentY < SCROLL_THRESHOLD) {
          if (isHidden) { header.classList.remove('rp-header-hidden'); header.classList.add('rp-header-visible'); isHidden = false; }
        } else if (diff > 4 && !isHidden) {
          header.classList.remove('rp-header-visible'); header.classList.add('rp-header-hidden'); isHidden = true;
        } else if (diff < -4 && isHidden) {
          header.classList.remove('rp-header-hidden'); header.classList.add('rp-header-visible'); isHidden = false;
        }
        lastScrollY = currentY;
        ticking = false;
      });
      ticking = true;
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
})();
</script>

<script>
(function () {
  function setGalleryHeight() {
    var gallery = document.querySelector('.rp-gallery');
    if (!gallery) return;
    var header =
      document.querySelector('.shopify-section-group-header-group') ||
      document.querySelector('#shopify-section-header') ||
      document.querySelector('sticky-header') ||
      document.querySelector('.header-wrapper') ||
      document.querySelector('header');
    var headerH = header ? header.getBoundingClientRect().height : 0;
    var h = window.innerHeight - headerH;
    gallery.style.height = h + 'px';
    gallery.style.maxHeight = h + 'px';
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setGalleryHeight);
  } else {
    setGalleryHeight();
  }
  window.addEventListener('resize', setGalleryHeight);
})();
</script>

<script>
(function() {
  function hideEl(el) {
    el.style.setProperty('display', 'none', 'important');
  }

  function mergeExternalTabs() {
    var tabsNav = document.querySelector('.rp-tabs-nav');
    var tabsWrap = document.querySelector('.rp-tabs-wrap');
    if (!tabsNav || !tabsWrap) return;

    var added = 0;

    function norm(str) { return (str || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }

    var existingBtns = {};
    tabsNav.querySelectorAll('.rp-tab-btn').forEach(function(btn) {
      existingBtns[norm(btn.textContent)] = btn;
    });

    function addOrUpdateTab(label, contentHtml) {
      var n = norm(label);
      if (existingBtns[n]) {
        var existing = existingBtns[n];
        var m = (existing.getAttribute('onclick') || '').match(/'([^']+)'/);
        if (m) {
          var p = document.getElementById('rp-tab-' + m[1]);
          if (p) p.innerHTML = contentHtml;
        }
        return;
      }
      var key = 'ext-' + label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      if (document.getElementById('rp-tab-' + key)) return;
      var btn = document.createElement('button');
      btn.className = 'rp-tab-btn';
      btn.type = 'button';
      btn.textContent = label;
      btn.onclick = function() { rpTabSwitch(btn, key); };
      tabsNav.appendChild(btn);
      var panel = document.createElement('div');
      panel.className = 'rp-tab-panel';
      panel.id = 'rp-tab-' + key;
      panel.innerHTML = contentHtml;
      tabsWrap.appendChild(panel);
      existingBtns[n] = btn;
      added++;
    }

    document.querySelectorAll('details').forEach(function(d) {
      var summary = d.querySelector(':scope > summary');
      if (!summary) return;
      var label = summary.textContent.trim();
      if (!label) return;
      var clone = d.cloneNode(true);
      clone.querySelector('summary').remove();
      var inner = clone.innerHTML.trim();
      if (!inner) return;
      addOrUpdateTab(label, inner);
      hideEl(d);
    });

    document.querySelectorAll('.lgcy-tab-item').forEach(function(item) {
      var h = item.querySelector('.lgcy-tab-item__heading');
      var c = item.querySelector('.lgcy-tab-item__content');
      if (!h || !c) return;
      var label = h.textContent.trim();
      var inner = c.innerHTML.trim();
      if (!label || !inner) return;
      addOrUpdateTab(label, inner);
      item.classList.add('lgcy-merged-to-tab');
    });

    if (added > 0) {
      ['sizechart', 'care'].forEach(function(key) {
        var panel = document.getElementById('rp-tab-' + key);
        var btn = tabsNav.querySelector('[onclick*="' + key + '"]');
        if (btn) btn.remove();
        if (panel) panel.remove();
      });
    }

    document.querySelectorAll('.lgcy-tabs-nav').forEach(function(n) { n.classList.add('lgcy-merged-to-tab'); });
  }

  if (document.readyState === 'complete') {
    mergeExternalTabs();
  } else {
    window.addEventListener('load', mergeExternalTabs);
  }
})();
</script>

