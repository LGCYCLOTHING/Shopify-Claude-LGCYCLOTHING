<script>
(function() {
  function getHeader() {
    return (
      document.querySelector('.shopify-section-group-header-group') ||
      document.querySelector('#shopify-section-header') ||
      document.querySelector('sticky-header') ||
      document.querySelector('.header-wrapper') ||
      document.querySelector('header[role="banner"]') ||
      document.querySelector('header')
    );
  }
  var header = getHeader();
  if (!header) return;
  var style = window.getComputedStyle(header);
  if (style.position === 'static') { header.style.position = 'relative'; }
  header.style.transition = 'transform 0.35s cubic-bezier(0.4, 0, 0.2, 1)';
  header.style.zIndex = '1000';
  var lastScrollY = window.scrollY, ticking = false, SCROLL_THRESHOLD = 80, isHidden = false;
  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(function() {
        var currentY = window.scrollY;
        var diff = currentY - lastScrollY;
        if (currentY < SCROLL_THRESHOLD) {
          if (isHidden) { header.classList.remove('rp-header-hidden'); header.classList.add('rp-header-visible'); isHidden = false; }
        } else if (diff > 4 && !isHidden) {
          header.classList.remove('rp-header-visible'); header.classList.add('rp-header-hidden'); isHidden = true;
        } else if (diff < -4 && isHidden) {
          header.classList.remove('rp-header-hidden'); header.classList.add('rp-header-visible'); isHidden = false;
        }
        lastScrollY = currentY;
        ticking = false;
      });
      ticking = true;
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
})();
</script>

<script>
(function () {
  function setGalleryHeight() {
    var gallery = document.querySelector('.rp-gallery');
    if (!gallery) return;
    var header =
      document.querySelector('.shopify-section-group-header-group') ||
      document.querySelector('#shopify-section-header') ||
      document.querySelector('sticky-header') ||
      document.querySelector('.header-wrapper') ||
      document.querySelector('header');
    var headerH = header ? header.getBoundingClientRect().height : 0;
    var h = window.innerHeight - headerH;
    gallery.style.height = h + 'px';
    gallery.style.maxHeight = h + 'px';
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setGalleryHeight);
  } else {
    setGalleryHeight();
  }
  window.addEventListener('resize', setGalleryHeight);
})();
</script>

