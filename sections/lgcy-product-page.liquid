<script>
(function() {
  var wrap = document.getElementById('lgcyNlTriggerWrap');
  var trigger = document.getElementById('lgcyNlTrigger');
  var dismiss = document.getElementById('lgcyNlDismiss');
  var overlay = document.getElementById('lgcyNlOverlay');
  var closeBtn = document.getElementById('lgcyNlClose');
  var closeSuccess = document.getElementById('lgcyNlCloseSuccess');
  var submitBtn = document.getElementById('lgcyNlSubmit');
  var emailInput = document.getElementById('lgcyNlEmail');
  var formWrap = document.getElementById('lgcyNlFormWrap');
  var success = document.getElementById('lgcyNlSuccess');

  function openModal() { overlay.classList.add('open'); setTimeout(function() { emailInput.focus(); }, 300); }
  function closeModal() { overlay.classList.remove('open'); }
  function dismissTrigger() {
    wrap.classList.add('dismissed');
    setTimeout(function() { wrap.style.display = 'none'; }, 300);
  }

  trigger.addEventListener('click', openModal);
  trigger.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') openModal(); });
  dismiss.addEventListener('click', function(e) { e.stopPropagation(); dismissTrigger(); });
  closeBtn.addEventListener('click', closeModal);
  closeSuccess.addEventListener('click', closeModal);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

  submitBtn.addEventListener('click', function() {
    var email = emailInput.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailInput.style.borderColor = '#e00';
      emailInput.focus();
      return;
    }
    emailInput.style.borderColor = '';
    submitBtn.textContent = '...';
    submitBtn.disabled = true;
    var fd = new FormData();
    fd.append('form_type', 'customer');
    fd.append('utf8', '✓');
    fd.append('contact[tags]', 'newsletter');
    fd.append('contact[email]', email);
    fetch('/contact', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .catch(function() {})
      .finally(function() {
        formWrap.classList.add('hidden');
        success.classList.add('visible');
      });
  });
})();
</script>

<script>
(function() {
  function hideEl(el) {
    el.style.setProperty('display', 'none', 'important');
  }

  function mergeExternalTabs() {
    var tabsNav = document.querySelector('.rp-tabs-nav');
    var tabsWrap = document.querySelector('.rp-tabs-wrap');
    if (!tabsNav || !tabsWrap) return;

    var added = 0;

    function norm(str) { return (str || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }

    var existingBtns = {};
    tabsNav.querySelectorAll('.rp-tab-btn').forEach(function(btn) {
      existingBtns[norm(btn.textContent)] = btn;
    });

    function addOrUpdateTab(label, contentHtml) {
      var n = norm(label);
      if (existingBtns[n]) {
        var existing = existingBtns[n];
        var m = (existing.getAttribute('onclick') || '').match(/'([^']+)'/);
        if (m) {
          var p = document.getElementById('rp-tab-' + m[1]);
          if (p) p.innerHTML = contentHtml;
        }
        return;
      }
      var key = 'ext-' + label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      if (document.getElementById('rp-tab-' + key)) return;
      var btn = document.createElement('button');
      btn.className = 'rp-tab-btn';
      btn.type = 'button';
      btn.textContent = label;
      btn.onclick = function() { rpTabSwitch(btn, key); };
      tabsNav.appendChild(btn);
      var panel = document.createElement('div');
      panel.className = 'rp-tab-panel';
      panel.id = 'rp-tab-' + key;
      panel.innerHTML = contentHtml;
      tabsWrap.appendChild(panel);
      existingBtns[n] = btn;
      added++;
    }

    document.querySelectorAll('details').forEach(function(d) {
      var summary = d.querySelector(':scope > summary');
      if (!summary) return;
      var label = summary.textContent.trim();
      if (!label) return;
      var clone = d.cloneNode(true);
      clone.querySelector('summary').remove();
      var inner = clone.innerHTML.trim();
      if (!inner) return;
      addOrUpdateTab(label, inner);
      hideEl(d);
    });

    document.querySelectorAll('.lgcy-tab-item').forEach(function(item) {
      var h = item.querySelector('.lgcy-tab-item__heading');
      var c = item.querySelector('.lgcy-tab-item__content');
      if (!h || !c) return;
      var label = h.textContent.trim();
      var inner = c.innerHTML.trim();
      if (!label || !inner) return;
      addOrUpdateTab(label, inner);
      item.classList.add('lgcy-merged-to-tab');
    });

    if (added > 0) {
      ['sizechart', 'care'].forEach(function(key) {
        var panel = document.getElementById('rp-tab-' + key);
        var btn = tabsNav.querySelector('[onclick*="' + key + '"]');
        if (btn) btn.remove();
        if (panel) panel.remove();
      });
    }

    document.querySelectorAll('.lgcy-tabs-nav').forEach(function(n) { n.classList.add('lgcy-merged-to-tab'); });
  }

  if (document.readyState === 'complete') {
    mergeExternalTabs();
  } else {
    window.addEventListener('load', mergeExternalTabs);
  }
})();
</script>

