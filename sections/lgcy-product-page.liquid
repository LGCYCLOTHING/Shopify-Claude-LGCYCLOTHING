  @media (max-width: 768px) {
    .rp-editorial { grid-template-columns: 1fr; background: #fff; min-height: auto; }
    .rp-editorial-text { padding: 40px 20px; order: 2; }
    .rp-editorial-media { order: 1; min-height: 72vw; }
    .rp-editorial-logo-bg { width: 700px; }
    .rp-cards-section { padding: 40px 20px; background: #fff; }
    .rp-card-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .rp-product-card-name { font-size: 11px; }
    .rp-product-card-price { font-size: 11px; }
  }
</style>

<section class="rp-editorial">
  <div class="rp-editorial-text">
    {%- if settings.logo != blank -%}
      {%- assign logo_bg_height = 1600 | divided_by: settings.logo.aspect_ratio -%}
      <img class="rp-editorial-logo-bg" src="{{ settings.logo | image_url: width: 1600 }}" width="1600" height="{{ logo_bg_height }}" alt="" aria-hidden="true" loading="lazy">
    {%- endif -%}
    <div class="rp-editorial-features">
      <div class="rp-editorial-feature">
        <h3 class="rp-editorial-feature-title">Oversized Fit</h3>
        <p class="rp-editorial-feature-desc">Relaxed, structured silhouette built to hold its shape.</p>
      </div>
      <div class="rp-editorial-feature">
        <h3 class="rp-editorial-feature-title">Relaxed Hem &amp; Cuffs</h3>
        <p class="rp-editorial-feature-desc">Loose, unribbed finish at the waist and sleeves for an effortless drop.</p>
      </div>
      <div class="rp-editorial-feature">
        <h3 class="rp-editorial-feature-title">Contrast Piping</h3>
        <p class="rp-editorial-feature-desc">White detailing along both sleeves.</p>
      </div>
      <div class="rp-editorial-feature">
        <h3 class="rp-editorial-feature-title">Signature Graphics</h3>
        <p class="rp-editorial-feature-desc">Front chest logo, bold back print — front to back.</p>
      </div>
    </div>
  </div>
  <div class="rp-editorial-media">
    <img src="{{ product.featured_image | img_url: '1200x' }}" alt="{{ product.title | escape }}">
  </div>
</section>

<section class="rp-cards-section">
  <h2 class="rp-section-label">You May Also Like</h2>
  <div class="rp-card-grid">
    {%- assign ymal_handles = 'driven-by-purpose-oversized-t-shirt,lgcy_black-purple' | split: ',' -%}
    {%- for handle in ymal_handles -%}
      {%- unless handle == product.handle -%}
        {%- assign rec = all_products[handle] -%}
        {%- if rec -%}
          <a href="{{ rec.url }}" class="rp-product-card">
            <div class="rp-product-card-img">
              <span class="rp-card-new-badge" aria-label="New product">NEW</span>
              {%- assign _rec_tags = rec.tags | join: ',' | downcase -%}
              {%- if _rec_tags contains 'blue-light' or _rec_tags contains 'bluelight' or _rec_tags contains 'blue light' -%}
                <span class="rp-card-bluelight-badge" aria-label="Blue light filter lens">
                  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="3.5"/>
                    <path d="M12 2v2"/>
                    <path d="M12 20v2"/>
                    <path d="m4.93 4.93 1.41 1.41"/>
                    <path d="m17.66 17.66 1.41 1.41"/>
                    <path d="M2 12h2"/>
                    <path d="M20 12h2"/>
                    <path d="m4.93 19.07 1.41-1.41"/>
                    <path d="m17.66 6.34 1.41-1.41"/>
                  </svg>
                  Blue Light
                </span>
              {%- endif -%}
              <img src="{{ rec.featured_image | img_url: '800x' }}" alt="{{ rec.title | escape }}" loading="lazy">
            </div>
            <span class="rp-product-card-name">{{ rec.title }}</span>
            <span class="rp-product-card-sub">{{ rec.type }}</span>
            <span class="rp-product-card-price">{{ rec.price | money }}</span>
          </a>
        {%- endif -%}
