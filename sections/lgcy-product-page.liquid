<script>
  // Give the info card its own Lenis smooth-scroll instance, same as the rest
  // of the site uses for the page. `data-lenis-prevent` on the card (see markup)
  // tells the site's global Lenis instances to ignore wheel events over it, so
  // this scoped instance is the only thing that reacts — no more double-scroll.
  (function () {
    var card = document.querySelector('.rp-inner');
    if (!card) return;

    function initCardLenis() {
      if (typeof Lenis === 'undefined') {
        requestAnimationFrame(initCardLenis);
        return;
      }
      var cardLenis = new Lenis({
        wrapper: card,
        duration: 1.1,
        easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
      });
      function raf(time) {
        cardLenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    }
    initCardLenis();
  })();

  // Instafeed (third-party app widget, "FOLLOW THE VISION") loads
  // asynchronously and has its own horizontally-scrollable wrapper —
  // without data-lenis-prevent, hovering it while scrolling makes the
  // page's global Lenis instance and the carousel's own scroll fight over
  // the same wheel events, which is exactly the "smooth scroll stops
  // working, needs extra wheel clicks" jank reported around this section.
  (function () {
    function markInstafeedScroller() {
      var wrapper = document.querySelector('.instafeed-new-layout-wrapper');
      if (wrapper && !wrapper.hasAttribute('data-lenis-prevent')) {
        wrapper.setAttribute('data-lenis-prevent', '');
      }
      return !!wrapper;
    }
    if (markInstafeedScroller()) return;
    var observer = new MutationObserver(function () {
      if (markInstafeedScroller()) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
    setTimeout(function () { observer.disconnect(); }, 20000);
  })();

  var rpImages = [
    {%- for img in product.images -%}
      "{{ img | img_url: '1600x' }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  var rpIdx = 0;

  function rpSetImg(i) {
    rpIdx = (i + rpImages.length) % rpImages.length;
    var el = document.getElementById('rp-main');
    el.style.opacity = '0';
    setTimeout(function() { el.src = rpImages[rpIdx]; el.style.opacity = '1'; }, 150);
    document.getElementById('rp-counter').textContent = (rpIdx + 1) + ' / ' + rpImages.length;
    document.querySelectorAll('.rp-thumb').forEach(function(t, idx) { t.classList.toggle('active', idx === rpIdx); });
  }
  function rpPrev() { rpSetImg(rpIdx - 1); }
  function rpNext() { rpSetImg(rpIdx + 1); }

  var rpWheelHandler = null;
  var rpTouchHandler = null;
  function rpLbOpen() {
    var lb = document.getElementById('rp-lightbox');
    var scrollY = window.scrollY || window.pageYOffset || 0;
    document.body.dataset.rpScrollY = scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = -scrollY + 'px';
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
    document.body.style.overflow = 'hidden';
    lb.classList.add('open');
    lb.scrollTop = 0;
    rpWheelHandler = function(e) { e.preventDefault(); lb.scrollTop += e.deltaY; };
    document.addEventListener('wheel', rpWheelHandler, { passive: false });
    rpTouchHandler = function(e) { if (!lb.contains(e.target)) e.preventDefault(); };
    document.addEventListener('touchmove', rpTouchHandler, { passive: false });
  }
  function rpLbClose() {
    document.getElementById('rp-lightbox').classList.remove('open');
    var scrollY = parseInt(document.body.dataset.rpScrollY || '0', 10);
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
    delete document.body.dataset.rpScrollY;
    window.scrollTo(0, scrollY);
    if (rpWheelHandler) { document.removeEventListener('wheel', rpWheelHandler, { passive: false }); rpWheelHandler = null; }
    if (rpTouchHandler) { document.removeEventListener('touchmove', rpTouchHandler, { passive: false }); rpTouchHandler = null; }
  }

  function rpAccToggle(key, triggerEl) {
    var body = document.getElementById('rp-acc-' + key);
    var isOpen = body.classList.contains('open');
    function pickDur(h) { return Math.min(1.2, 0.45 + h * 0.0011) + 's'; }
    document.querySelectorAll('.rp-acc-body').forEach(function(b) {
      if (b.classList.contains('open')) { b.style.transitionDuration = pickDur(b.scrollHeight); }
      b.classList.remove('open');
      b.style.maxHeight = '0px';
    });
    document.querySelectorAll('.rp-acc-trigger').forEach(function(t) { t.classList.remove('open'); });
    if (!isOpen) {
      body.classList.add('open');
      triggerEl.classList.add('open');
      var h = body.scrollHeight;
      body.style.transitionDuration = pickDur(h);
      body.style.maxHeight = h + 'px';
    }
  }

  function rpTabSwitch(btn, key) {
    var wrap = btn.closest('.rp-tabs-wrap');
    wrap.querySelectorAll('.rp-tab-btn').forEach(function(b) { b.classList.remove('is-active'); });
    wrap.querySelectorAll('.rp-tab-panel').forEach(function(p) { p.classList.remove('is-active'); });
    btn.classList.add('is-active');
    document.getElementById('rp-tab-' + key).classList.add('is-active');
  }

  // "Size & Fit Guide" (top of the info column) jumps straight to the
  // Size Chart tab further down instead of leaving the shopper to find it.
  function rpShowSizeChartTab() {
    var wrap = document.querySelector('.rp-tabs-wrap');
    if (!wrap) return;
    var tabBtn = wrap.querySelector('.rp-tab-btn[onclick*="sizechart"]');
    if (tabBtn) rpTabSwitch(tabBtn, 'sizechart');
    wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Size chart CM/IN toggle — swaps each cell's displayed value between its
  // data-cm and data-in attributes instead of keeping two separate tables.
  function rpSizeChartUnit(unit) {
    document.querySelectorAll('.rp-sizechart-table td[data-cm]').forEach(function (td) {
      td.textContent = unit === 'cm' ? td.getAttribute('data-cm') : td.getAttribute('data-in');
    });
    var toggle = document.getElementById('rp-sizechart-unit-toggle');
    if (toggle) toggle.checked = (unit === 'in');
    var cmLabel = document.getElementById('rp-sizechart-label-cm');
    var inLabel = document.getElementById('rp-sizechart-label-in');
    if (cmLabel) cmLabel.classList.toggle('is-active', unit === 'cm');
    if (inLabel) inLabel.classList.toggle('is-active', unit === 'in');
    var unitWord = document.getElementById('rp-sizechart-unit-word');
    if (unitWord) unitWord.textContent = unit === 'cm' ? 'centimeters' : 'inches';
  }

  function rpOpt(el, labelId) {
    el.parentElement.querySelectorAll('.rp-swatch,.rp-swatch-plain').forEach(function(x) { x.classList.remove('active'); });
    el.classList.add('active');
    document.getElementById(labelId).textContent = el.dataset.val;
    rpVariant();
  }
  function rpSize(el) {
    document.getElementById('rp-sizes').querySelectorAll('.rp-size').forEach(function(x) { x.classList.remove('active'); });
    el.classList.add('active');
    rpVariant();
  }
  function rpVariant() {
    var opts = [];
    document.querySelectorAll('[data-oi].active').forEach(function(el) {
      opts[parseInt(el.dataset.oi) - 1] = el.dataset.val;
    });
    var variants = {{ product.variants | json }};
    var match = variants.find(function(v) {
      return v.options.every(function(o, i) { return !opts[i] || o === opts[i]; });
    });
    if (match) {
      document.getElementById('rp-vid').value = match.id;
      if (typeof window.lgcyUpdateStockPill === 'function') {
        window.lgcyUpdateStockPill(match.available, match.inventory_quantity);
      }
    }
  }

  /* Require an explicit size pick before Add to Cart goes through — without
     this, the hidden variant input already holds
     product.selected_or_first_available_variant from page load, so clicking
     Add to Cart with no size chosen silently added whatever size sorts
     first. Runs in the capture phase so it fires (and can fully cancel the
     event via stopImmediatePropagation) before any other submit handler —
     e.g. the mobile sticky bar in theme.liquid — gets a chance to AJAX the
     add through regardless of attachment order. */
  (function () {
    var form = document.getElementById('rp-atc-btn') && document.getElementById('rp-atc-btn').closest('form');
    var btn = document.getElementById('rp-atc-btn');
    var sizesWrap = document.getElementById('rp-sizes');
    if (!form || !btn) return;

    var labelEl = btn.querySelector('span');
    var originalLabel = labelEl ? labelEl.textContent : 'Add to Cart';
    var revertTimer = null;

    function isSizeSelected() {
      return !sizesWrap || !!sizesWrap.querySelector('.rp-size.active');
    }

    /* Buy with Shop / Apple Pay checks out with whatever variant the
       hidden id input currently holds — unlike Add to Cart above, it has
       no submit event to intercept and prompt for a size, so it stays
       hidden until a size is actually picked (or shows immediately for
       products with no size option at all). */
    var dynamicCheckout = document.querySelector('.rp-dynamic-checkout');
    function updateDynamicCheckoutVisibility() {
      if (!dynamicCheckout) return;
      dynamicCheckout.classList.toggle('rp-dynamic-checkout--hidden', !isSizeSelected());
    }
    updateDynamicCheckoutVisibility();

    window.rpRevertAtcLabel = function () {
      clearTimeout(revertTimer);
      if (labelEl) labelEl.textContent = originalLabel;
      btn.classList.remove('rp-btn-cart--needs-size');
    };

    function promptForSize() {
      if (!labelEl) return;
      clearTimeout(revertTimer);
      labelEl.textContent = 'Select a Size';
      btn.classList.add('rp-btn-cart--needs-size');
      revertTimer = setTimeout(window.rpRevertAtcLabel, 2200);
    }

    /* Take full ownership of this submit — AJAX the add-to-cart through and
       open the cart drawer ourselves, on every device. Previously only the
       mobile sticky bar (theme.liquid, <=860px) hijacked this form, so a
       desktop click did a native POST (full page reload, no drawer) instead
       of the AJAX + open-drawer behaviour every other add-to-cart path here
       already has. */
    function ajaxAddMain() {
      var variantInput = document.getElementById('rp-vid');
      var variantId = variantInput && variantInput.value;
      if (!variantId || btn.disabled) return;

      btn.disabled = true;
      btn.classList.add('lgcy-adding');

      var cartDrawer = document.querySelector('cart-drawer');
      var sections = cartDrawer && typeof cartDrawer.getSectionsToRender === 'function'
        ? cartDrawer.getSectionsToRender().map(function (s) { return s.id; })
        : ['cart-drawer', 'cart-icon-bubble'];

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          id: parseInt(variantId, 10),
          quantity: 1,
          sections: sections,
          sections_url: window.location.pathname
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.status && data.status !== 200) return;
          if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
            cartDrawer.renderContents(data);
          }
        })
        .finally(function () {
          btn.disabled = false;
          btn.classList.remove('lgcy-adding');
        });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      e.stopImmediatePropagation();
      if (!isSizeSelected()) {
        promptForSize();
        return;
      }
      ajaxAddMain();
    }, true);

    if (sizesWrap) {
      sizesWrap.addEventListener('click', function (e) {
        if (e.target.closest('.rp-size')) {
          window.rpRevertAtcLabel();
          updateDynamicCheckoutVisibility();
        }
      });
    }
  })();

  function rpNisOpen() {
    var activeSize = document.querySelector('#rp-sizes .rp-size.active');
    var sel = document.getElementById('rp-nis-size');
    if (activeSize && sel) sel.value = activeSize.dataset.val;
    document.getElementById('rp-nis-modal').classList.add('open');
  }
  function rpNisClose() { document.getElementById('rp-nis-modal').classList.remove('open'); }
  function rpNisClick(e) { if (e.target === document.getElementById('rp-nis-modal')) rpNisClose(); }
  function rpNisSubmit() {
    var email = document.getElementById('rp-nis-email').value.trim();
    var size  = document.getElementById('rp-nis-size').value;
    if (!email || !size) { alert('Please fill in all fields.'); return; }
    document.getElementById('rp-nis-success').style.display = 'block';
    document.getElementById('rp-nis-email').value = '';
  }

  (function() {
    var gallery = document.querySelector('.rp-gallery');
    if (gallery) {
      var txStart = 0;
      gallery.addEventListener('touchstart', function(e) { txStart = e.touches[0].clientX; }, { passive: true });
      gallery.addEventListener('touchend', function(e) {
        var diff = txStart - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) { if (diff > 0) rpNext(); else rpPrev(); }
      }, { passive: true });
    }
  })();

  (function() {
    document.querySelectorAll('.rp-btn-cart, .rp-nis-submit').forEach(function(btn) {
      btn.addEventListener('mousemove', function(e) {
        var rect = btn.getBoundingClientRect();
        btn.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
        btn.style.setProperty('--my', (e.clientY - rect.top) + 'px');
        btn.style.setProperty('--mr', '240px');
      });
      btn.addEventListener('mouseleave', function() { btn.style.setProperty('--mr', '0px'); });
    });
  })();
</script>

