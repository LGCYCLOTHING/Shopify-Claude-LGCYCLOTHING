<style>
  .lgcy-drop {
    background: #faf8f4;
    padding: 4px 20px 24px;
  }
  .lgcy-drop-header {
    max-width: 700px;
    margin: 0 auto 14px;
    text-align: center;
  }
  .lgcy-drop-title {
    font-family: 'Inter', Helvetica, Arial, sans-serif;
    font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #000000;
    line-height: 1;
    margin: 0;
  }

  /* Reuses the site's shared product card (snippets/lgcy-product-card.liquid)
     for every slot, so badges, bold title/price, and the real quick-add ->
     size picker -> cart drawer flow all match the collection pages exactly.
     Capping the grid width (rather than a separate mobile breakpoint) is
     what makes the cards noticeably smaller on every device. */
  .lgcy-drop-grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* Coming-soon products (the 2 glasses) recede visually so the one
     product people can actually buy right now stands out. */
  .lgcy-drop-item--muted {
    opacity: 0.5;
    filter: grayscale(0.5);
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .lgcy-drop-item--muted:hover {
    opacity: 0.8;
    filter: grayscale(0.2);
  }
</style>

<div class="lgcy-drop">
  {%- if section.settings.heading != blank -%}
    <div class="lgcy-drop-header">
      <h2 class="lgcy-drop-title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="lgcy-drop-grid">
    {%- comment -%} Keep in sync with coming_soon_handles in snippets/lgcy-pdp-badges.liquid, snippets/lgcy-sticky-cart.liquid, snippets/lgcy-product-card.liquid, and COMING_SOON_HANDLES in assets/cart-drawer.js. {%- endcomment -%}
    {%- assign coming_soon_handles = 'lgcy-01-aeris-black-clear,lgcy_black-purple' | split: ',' -%}
    {%- for block in section.blocks -%}
      {%- assign drop_product = block.settings.product -%}
      {%- if drop_product != blank -%}
        {%- assign is_muted = false -%}
        {%- if coming_soon_handles contains drop_product.handle -%}
          {%- assign is_muted = true -%}
        {%- endif -%}
        <div class="{% if is_muted %}lgcy-drop-item--muted{% endif %}" {{ block.shopify_attributes }}>
          {%- render 'lgcy-product-card', product: drop_product, lazy: false, cta_label: 'Add to Cart' -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop The Drop",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Drop."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop The Drop",
      "category": "Main",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
