    "custom_liquid_y4tFFP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .lgcy-hero-scroll-wrapper {\n    height: 200vh;\n  }\n  .lgcy-hero-scroll-wrapper > .shopify-section.videoBackground {\n    position: sticky !important;\n    top: 0 !important;\n    height: 100vh !important;\n    overflow: hidden !important;\n    z-index: 2 !important;\n  }\n  /* Pin title to viewport center while hero is active — full sticky-pin\n     collections only (see the Liquid guard on the block below). */\n  {%- unless collection.handle == 'lgcy-glasses' or collection.handle == 'the-legacy-collection' or collection.handle == 'all' -%}\n  #hero-title-collection {\n    position: fixed !important;\n    left: 50% !important;\n    transform: translate(-50%, -50%) !important;\n    z-index: 20 !important;\n    pointer-events: none !important;\n  }\n  {%- endunless -%}\n  /* Simple hero collections: title just sits centered in the (natural-height,\n     non-sticky) video section — no scroll-driven movement. */\n  {%- if collection.handle == 'lgcy-glasses' or collection.handle == 'the-legacy-collection' or collection.handle == 'all' -%}\n  #hero-title-collection {\n    position: absolute !important;\n    top: 50% !important;\n    left: 50% !important;\n    transform: translate(-50%, -50%) !important;\n    z-index: 5 !important;\n    pointer-events: none !important;\n  }\n  {%- endif -%}\n  .lgcy-clear-layer {\n    position: absolute;\n    inset: 0;\n    z-index: 6;\n    overflow: hidden;\n    clip-path: inset(100% 0 0 0);\n  }\n  .lgcy-clear-layer .fullscreen-video-wrap {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n  }\n  .lgcy-wipe-line {\n    position: fixed;\n    left: 0;\n    top: 100vh;\n    width: 100%;\n    height: 28px;\n    background: #ffffff;\n    z-index: 99999;\n    pointer-events: none;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n  }\n  .lgcy-wipe-chevron {\n    flex-shrink: 0;\n    color: #000000;\n  }\n  .lgcy-wipe-label {\n    font-family: 'Inter', sans-serif;\n    font-weight: 900;\n    font-size: 13px;\n    letter-spacing: -0.05em;\n    color: #000000;\n    white-space: nowrap;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n  /* Hide duplicate banner on desktop */\n  #shopify-section-banner {\n    display: none !important;\n  }\n  @media screen and (max-width: 749px) {\n    .lgcy-hero-scroll-wrapper { height: auto !important; }\n    .lgcy-hero-scroll-wrapper > .shopify-section.videoBackground { position: relative !important; }\n    .lgcy-clear-layer, .lgcy-wipe-line { display: none !important; }\n    #hero-title-collection { position: absolute !important; }\n    #shopify-section-banner { display: block !important; }\n  }\n</style>\n<script>\n  (function() {\n    function initHeroEffect() {\n      var section = document.querySelector('.videoBackground');\n      if (!section) return;\n      if (window.innerWidth <= 749) return;\n\n      var titleEl = document.getElementById('hero-title-collection');\n\n      /* Collections listed here get a plain static hero: video plays at its\n         natural height, title sits centered in it, content follows right\n         after — no 200vh sticky-pin scroll-through, no blur-in/wipe-reveal,\n         no scroll-driven title movement. */\n      var SIMPLE_HERO_COLLECTIONS = ['lgcy-glasses', 'the-legacy-collection', 'all'];\n      var useSimpleHero = SIMPLE_HERO_COLLECTIONS.indexOf({{ collection.handle | json }}) !== -1;\n\n      if (useSimpleHero) {\n        if (titleEl) {\n          if (getComputedStyle(section).position === 'static') {\n            section.style.position = 'relative';\n          }\n          section.appendChild(titleEl);\n        }\n        return;\n      }\n\n      /* hide duplicate banner */\n      var banner = document.getElementById('shopify-section-banner');\n      if (banner) banner.style.display = 'none';\n\n      var wrapper = document.createElement('div');\n      wrapper.className = 'lgcy-hero-scroll-wrapper';\n      section.parentNode.insertBefore(wrapper, section);\n      wrapper.appendChild(section);\n\n      var origVideo = section.querySelector('.video-js');\n      if (origVideo) {\n        origVideo.style.filter = 'blur(10px) brightness(0.45) grayscale(0.4) contrast(1.0)';\n        origVideo.style.transform = 'scale(1.06)';\n        origVideo.style.transformOrigin = 'center center';\n      }\n\n      var origWrap = section.querySelector('.fullscreen-video-wrap');\n      var clearLayer = document.createElement('div');\n      clearLayer.className = 'lgcy-clear-layer';\n      if (origWrap) {\n        var clonedWrap = origWrap.cloneNode(true);\n        var clonedVideo = clonedWrap.querySelector('video');\n        if (clonedVideo) {\n          clonedVideo.style.filter = 'brightness(0.45) grayscale(0.4) contrast(1.0)';\n          clonedVideo.muted = true;\n          clonedVideo.loop = true;\n          clonedVideo.play().catch(function(){});\n        }\n        clearLayer.appendChild(clonedWrap);\n      }\n      section.appendChild(clearLayer);\n\n      var line = document.createElement('div');\n      line.className = 'lgcy-wipe-line';\n      var chevronSVG = '<svg class=\"lgcy-wipe-chevron\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m17 11-5-5-5 5\"/><path d=\"m17 18-5-5-5 5\"/></svg>';\n      line.innerHTML = chevronSVG + '<span class=\"lgcy-wipe-label\">LGCYCLOTHING</span>' + chevronSVG;\n      document.body.appendChild(line);\n\n      var heroHeight = window.innerHeight;\n\n      /* set initial top via JS so CSS !important on top doesn't interfere */\n      if (titleEl) titleEl.style.top = '50%';\n\n      function onScroll() {\n        var scrollY = window.pageYOffset;\n        var progress = Math.min(1, Math.max(0, scrollY / heroHeight));\n        var blurPct = (1 - progress) * 100;\n        clearLayer.style.clipPath = 'inset(' + blurPct.toFixed(2) + '% 0 0 0)';\n        /* fixed line tracks wipe boundary; visible from page load as indicator */\n        if (progress <= 1) {\n          line.style.display = 'flex';\n          line.style.top = 'calc(' + blurPct.toFixed(2) + 'vh - 28px)';\n        } else {\n          line.style.display = 'none';\n        }\n        /* text moves up from scroll start */\n        if (titleEl) {\n          var topPct = 50 - progress * 100;\n          titleEl.style.top = topPct.toFixed(2) + '%';\n          titleEl.style.visibility = topPct < -15 ? 'hidden' : 'visible';\n        }\n      }\n      window.addEventListener('scroll', onScroll, { passive: true });\n      onScroll();\n    }\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initHeroEffect);\n    } else {\n      initHeroEffect();\n    }\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
