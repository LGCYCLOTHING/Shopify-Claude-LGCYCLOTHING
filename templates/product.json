;\n    color: #111; cursor: pointer;\n    border-bottom: 1px solid #e0e0e0;\n  }\n  .rp-acc-trigger:hover { opacity: 0.7; }\n  .rp-trigger-icon {\n    font-size: 20px; font-weight: 300; line-height: 1;\n    transition: transform 0.3s ease; flex-shrink: 0; margin-left: 12px;\n  }\n  .rp-acc-trigger.open .rp-trigger-icon { transform: rotate(45deg); }\n  .rp-acc-body {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.7s cubic-bezier(0.22, 1, 0.36, 1);\n    border-bottom: 1px solid #e0e0e0;\n  }\n  .rp-acc-body-inner {\n    position: relative;\n    padding: 20px 0 28px;\n    font-size: 13px; font-weight: 400;\n    color: #444; line-height: 1.85;\n  }\n  .rp-acc-body-inner ul { padding-left: 16px; margin-top: 8px; margin-bottom: 8px; list-style: disc; }\n  .rp-acc-body-inner li { margin-bottom: 4px; }\n  .rp-acc-body-inner p { margin-bottom: 10px; }\n  .rp-acc-body-inner strong { color: #111; font-weight: 700; }\n  .rp-acc-body-inner p:last-child { margin-bottom: 0; }\n  .rp-acc-close { display: none; }\n\n /* ── Tabs: Shipping / Size Chart / Care ── */\n.rp-tabs-wrap {\n  padding-top: 20px;\n  border-top: 1px solid #e0e0e0;\n}\n.rp-tabs-nav {\n  display: flex;\n  border-bottom: 2px solid rgba(0,0,0,0.10);\n}\n.rp-tab-btn {\n  flex: 1;\n  text-align: center;\n  font-family: 'Inter', Helvetica, 'Helvetica Neue', Arial, sans-serif;\n  font-size: 12px; font-weight: 800; letter-spacing: -0.04em; text-transform: uppercase;\n  background: none; border: none; padding: 0 0 14px 0;\n  cursor: pointer; color: rgba(0,0,0,0.32); position: relative; white-space: nowrap;\n}\n.rp-tab-btn.is-active { color: #111; }\n.rp-tab-btn.is-active::after {\n  content: ''; position: absolute; bottom: -2px; left: 0; right: 0;\n  height: 3px; background: #111;\n}\n.rp-tab-panel {\n  display: none; padding-top: 18px;\n  font-size: 11px; font-weight: 600; color: #444; line-height: 1.55;\n}\n.rp-tab-panel.is-active { display: block; }\n.rp-tab-panel p { margin-bottom: 10px; }\n.rp-tab-panel p:last-child { margin-bottom: 0; }\n.rp-tab-panel strong { color: #111; font-weight: 700; }\n\n\n  /* ── \"Size Not In Stock\" modal ── */\n  .rp-nis-modal {\n    display: none; position: fixed; inset: 0;\n    background: rgba(0,0,0,0.5); z-index: 8888;\n    align-items: center; justify-content: center;\n  }\n  .rp-nis-modal.open { display: flex; }\n  .rp-nis-box {\n    background: linear-gradient(180deg, #f4f4f4 0%, #c8c8c8 100%);\n    padding: 36px 32px 28px; width: 100%; max-width: 420px; position: relative;\n    border-radius: 18px; box-shadow: 0 24px 60px rgba(0,0,0,0.4);\n  }\n  .rp-nis-close {\n    position: absolute; top: 14px; right: 18px;\n    background: none; border: none; font-size: 24px; cursor: pointer; color: #555; line-height: 1;\n  }\n  .rp-nis-title { font-size: 14px; font-weight: 900; letter-spacing: -0.02em; text-transform: uppercase; margin-bottom: 6px; color: #111; }\n  .rp-nis-sub { font-size: 12px; font-weight: 900; letter-spacing: -0.02em; color: #444; margin-bottom: 20px; }\n  .rp-nis-form { display: flex; flex-direction: column; gap: 10px; }\n  .rp-nis-form input, .rp-nis-form select {\n    height: 44px; padding: 0 12px; border: 1px solid #aaa;\n    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;\n    font-size: 12px; font-weight: 900; letter-spacing: -0.02em; color: #111; background: #fff; outline: none; width: 100%;\n    border-radius: 10px;\n  }\n  .rp-nis-form input:focus, .rp-nis-form select:focus { border-color: #111; }\n  .rp-nis-submit {\n    position: relative; overflow: hidden; isolation: isolate;\n    height: 52px;\n    background: rgba(255, 255, 255, 0.22);\n    backdrop-filter: blur(20px) saturate(180%);\n    -webkit-backdrop-filter: blur(20px) saturate(180%);\n    color: #111; border: 1px solid rgba(255, 255, 255, 0.6);\n    border-radius: 999px;\n    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;\n    font-size: 11px; font-weight: 900; letter-spacing: -0.02em; text-transform: uppercase;\n    cursor: pointer;\n    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8), inset 0 -1px 2px rgba(255, 255, 255, 0.3), 0 6px 18px rgba(0, 0, 0, 0.12);\n    --mx: 50%; --my: 50%; --mr: 0px;\n  }\n  .rp-nis-submit::before {\n    content: ''; position: absolute; inset: 0; z-index: 1;\n    pointer-events: none; will-change: background-position;\n    background: repeating-linear-gradient(120deg, rgba(255,255,255,0) 0, rgba(255,255,255,0) 90px, rgba(255,255,255,0.85) 150px, rgba(255,255,255,0) 210px, rgba(255,255,255,0) 320px);\n    animation: rp-btn-sweep 5s linear infinite;\n  }\n  .rp-nis-submit::after {\n    content: ''; position: absolute; inset: 0; z-index: 2;\n    pointer-events: none;\n    background: radial-gradient(circle var(--mr) at var(--mx) var(--my), rgba(255,255,255,0.75) 0%, rgba(255,255,255,0.4) 30%, rgba(255,255,255,0.1) 60%, transparent 100%);\n    transition: background 0.12s ease-out;\n  }\n  .rp-nis-submit > span { position: relative; z-index: 3; }\n  .rp-nis-success { display: none; font-size: 12px; font-weight: 600; color: #22c55e; margin-top: 10px; text-align: center; }\n\n  /* ── Mobile ── */\n  @media (max-width: 860px) {\n    .rp-wrap { grid-template-columns: 1fr; }\n    .rp-gallery { position: relative; height: 90vw; }\n    .rp-info { min-height: auto; padding: 36px 24px 40px; border-left: none; border-top: 1px solid #e6e6e6; align-items: flex-start; }\n    .rp-inner { max-width: 100%; }\n    .rp-sizes { grid-template-columns: repeat(5, 1fr); }\n  }\n</style>\n\n{%- assign p = product -%}\n{%- assign v = p.selected_or_first_available_variant -%}\n{%- assign img_count = p.images.size -%}\n\n<!-- Lightbox -->\n<div class=\"rp-lightbox\" id=\"rp-lightbox\" onclick=\"rpLbClose()\">\n  <button class=\"rp-lb-close\" onclick=\"rpLbClose()\" type=\"button\">&times;</button>\n  <div class=\"rp-lb-inner\">\n    {%- for img in p.images -%}\n      <div class=\"rp-lb-img-item\">\n        <img src=\"{{ img | img_url: '2048x' }}\" alt=\"{{ img.alt | escape }}\">\n      </div>\n    {%- endfor -%}\n  </div>\n</div>\n\n<!-- Size Not In Stock modal -->\n<div class=\"rp-nis-modal\" id=\"rp-nis-modal\" onclick=\"rpNisClick(event)\">\n  <div class=\"rp-nis-box\">\n    <button class=\"rp-nis-close\" onclick=\"rpNisClose()\" type=\"button\">&times;</button>\n    <div class=\"rp-nis-title\">Notify Me When Available</div>\n    <div class=\"rp-nis-sub\">Enter your email and we'll let you know when your size is back in stock.</div>\n    <div class=\"rp-nis-form\">\n      <select id=\"rp-nis-size\">\n        <option value=\"\" disabled selected>Select a size</option>\n        {%- for opt in p.options_with_values -%}\n          {%- if opt.name == 'Size' -%}\n            {%- for val in opt.values -%}\n              <option value=\"{{ val }}\">{{ val }}</option>\n            {%- endfor -%}\n          {%- endif -%}\n        {%- endfor -%}\n      </select>\n      <input type=\"email\" id=\"rp-nis-email\" placeholder=\"YOUR EMAIL ADDRESS\" autocomplete=\"email\">\n      <button class=\"rp-nis-submit\" type=\"button\" onclick=\"rpNisSubmit()\"><span>Notify Me</span></button>\n      <div class=\"rp-nis-success\" id=\"rp-nis-success\">✓ You'll be notified when this size is back in stock.</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"rp-wrap\">\n\n  <!-- LEFT: Gallery -->\n  <div class=\"rp-gallery\">\n    <img id=\"rp-main\" class=\"rp-main-img\"\n         src=\"{{ p.featured_image | img_url: '1600x' }}\"\n         alt=\"{{ p.featured_image.alt | escape }}\"\n         onclick=\"rpLbOpen()\">\n\n    {%- if img_count > 1 -%}\n      <button class=\"rp-arrow rp-arrow-left\" onclick=\"rpPrev()\" type=\"button\" aria-label=\"Previous\">\n        <svg width=\"10\" height=\"18\" viewBox=\"0 0 10 18\" fill=\"none\">\n          <path d=\"M9 1L1 9L9 17\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </button>\n      <button class=\"rp-arrow rp-arrow-right\" onclick=\"rpNext()\" type=\"button\" aria-label=\"Next\">\n        <svg width=\"10\" height=\"18\" viewBox=\"0 0 10 18\" fill=\"none\">\n          <path d=\"M1 1L9 9L1 17\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </button>\n    {%- endif -%}\n\n<div class=\"rp-thumbs\" id=\"rp-thumbs\">\n  {%- for img in p.images -%}\n    <button class=\"rp-thumb {% if forloop.first %}active{% endif %}\" type=\"button\" onclick=\"rpSetImg({{ forloop.index0 }})\" data-idx=\"{{ forloop.index0 }}\">\n      <img src=\"{{ img | img_url: '200x' }}\" alt=\"{{ img.alt | escape }}\">\n    </button>\n  {%- endfor -%}\n</div>\n\n    <div class=\"rp-counter\" id=\"rp-counter\">1 / {{ img_count }}</div>\n\n    <button class=\"rp-expand\" onclick=\"rpLbOpen()\" type=\"button\" aria-label=\"Zoom\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 3h6v6\"/><path d=\"m21 3-7 7\"/><path d=\"m3 21 7-7\"/><path d=\"M9 21H3v-6\"/></svg>\n    </button>\n  </div>\n\n  <!-- RIGHT: Info panel -->\n  <div class=\"rp-info\" id=\"rp-info\">\n    <div class=\"rp-inner\">\n\n      <!-- Title + Price -->\n      <div class=\"rp-header\">\n        <h1 class=\"rp-title\">{{ p.title }}</h1>\n        <span class=\"rp-price\">\n          {%- if v.compare_at_price > v.price -%}\n            <s style=\"color:#aaa;margin-right:4px;\">{{ v.compare_at_price | money }}</s>\n          {%- endif -%}\n          {{ v.price | money }}\n        </span>\n      </div>\n\n      {%- unless p.has_only_default_variant -%}\n\n        {%- for opt in p.options_with_values -%}\n          {%- if opt.name == 'Color' or opt.name == 'Colour' -%}\n            <div class=\"rp-section\">\n              <div class=\"rp-color-header\">\n                <span class=\"rp-color-label\">Select Color</span>\n                <span class=\"rp-color-val\" id=\"rp-color-val\">{{ opt.values.first }}</span>\n              </div>\n              <div class=\"rp-swatches\">\n                {%- for val in opt.values -%}\n                  {%- assign swatch_img = p.images | where: \"alt\", val | first -%}\n                  <div class=\"rp-swatch {% if forloop.first %}active{% endif %}\"\n                       title=\"{{ val }}\" data-oi=\"{{ opt.position }}\" data-val=\"{{ val }}\"\n                       onclick=\"rpOpt(this,'rp-color-val')\">\n                    {%- if swatch_img -%}\n                      <img src=\"{{ swatch_img | img_url: '130x' }}\" alt=\"{{ val | escape }}\">\n                    {%- else -%}\n                      <div style=\"width:100%;height:100%;background:{{ val | downcase | replace:' ','' }};\"></div>\n                    {%- endif -%}\n                  </div>\n                {%- endfor -%}\n              </div>\n            </div>\n          {%- endif -%}\n        {%- endfor -%}\n\n        {%- for opt in p.options_with_values -%}\n          {%- if opt.name == 'Size' -%}\n            <div class=\"rp-section\">\n              <div class=\"rp-size-header\">\n                <span class=\"rp-size-label\">Model is wearing size M</span>\n                <button class=\"rp-size-guide\" type=\"button\" onclick=\"rpAccToggle('sizechart', this)\">Size &amp; Fit Guide</button>\n              </div>\n              <div class=\"rp-sizes\" id=\"rp-sizes\">\n                {%- for val in opt.values -%}\n                  {%- assign size_avail = false -%}\n                  {%- for variant in p.variants -%}\n                    {%- if variant.option1 == val or variant.option2 == val -%}\n                      {%- if variant.available -%}{%- assign size_avail = true -%}{%- endif -%}\n                    {%- endif -%}\n                  {%- endfor -%}\n                  <button type=\"button\"\n                          class=\"rp-size{% if forloop.first and size_avail %} active{% endif %}{% unless size_avail %} soldout{% endunless %}\"\n                          data-oi=\"{{ opt.position }}\" data-val=\"{{ val }}\"\n                          {% unless size_avail %}disabled{% endunless %}\n                          onclick=\"rpSize(this)\">{{ val }}</button>\n                {%- endfor -%}\n              </div>\n              <button class=\"rp-size-nis\" type=\"button\" onclick=\"rpNisOpen()\">Size Not In Stock?</button>\n            </div>\n          {%- endif -%}\n        {%- endfor -%}\n\n      {%- endunless -%}\n\n      <!-- Add to Cart -->\n      {%- form 'product', p -%}\n        <input type=\"hidden\" name=\"id\" id=\"rp-vid\" value=\"{{ v.id }}\">\n        <button type=\"submit\" name=\"add\" class=\"rp-btn-cart\"><span>Add to Cart</span></button>\n      {%- endform -%}\n\n      <!-- USP bar -->\n      <div class=\"rp-usp\">\n        <div class=\"rp-usp-row\">\n          <div class=\"rp-usp-icon\">\n            <span style=\"width:8px;height:8px;border-radius:50%;border:1.5px solid #777;display:block;\"></span>\n          </div>\n          <span class=\"rp-usp-text\">Free Shipping</span>\n        </div>\n        <div class=\"rp-usp-row\">\n          <div class=\"rp-usp-icon\">\n            {%- if v.available == false -%}\n              <span class=\"rp-dot rp-dot-out\"></span>\n            {%- elsif v.inventory_quantity > 0 and v.inventory_quantity <= 10 -%}\n              <span class=\"rp-dot rp-dot-low\"></span>\n            {%- else -%}\n              <span class=\"rp-dot rp-dot-in\"></span>\n            {%- endif -%}\n          </div>\n          <span class=\"rp-usp-text\">\n            {%- if v.available == false -%}Out of Stock\n            {%- elsif v.inventory_quantity > 0 and v.inventory_quantity <= 10 -%}Limited Stock\n            {%- else -%}In Stock{%- endif -%}\n          </span>\n        </div>\n      </div>\n\n      <!-- Product Details accordion -->\n      <div class=\"rp-acc-list\">\n        <button class=\"rp-acc-trigger\" type=\"button\" onclick=\"rpAccToggle('details', this)\">\n          Product Details\n          <span class=\"rp-trigger-icon\">+</span>\n        </button>\n        <div class=\"rp-acc-body\" id=\"rp-acc-details\">\n          <div class=\"rp-acc-body-inner\">\n            {{ p.description }}\n          </div>\n        </div>\n      </div>\n\n      <!-- Tabs: Shipping / Size Chart / Care Instructions -->\n      <div class=\"rp-tabs-wrap\">\n        <div class=\"rp-tabs-nav\">\n          <button class=\"rp-tab-btn is-active\" type=\"button\" onclick=\"rpTabSwitch(this,'shipping')\">Shipping &amp; Returns</button>\n          <button class=\"rp-tab-btn\" type=\"button\" onclick=\"rpTabSwitch(this,'sizechart')\">Size Chart</button>\n          <button class=\"rp-tab-btn\" type=\"button\" onclick=\"rpTabSwitch(this,'care')\">Care Instructions</button>\n        </div>\n        <div class=\"rp-tab-panel is-active\" id=\"rp-tab-shipping\">\n          <p>Free shipping on orders over $175.</p>\n          <p>Returns accepted within 30 days of delivery. Items must be unworn and in original condition with all tags attached.</p>\n          <p>To initiate a return, contact us at <strong>support@lgcyclothing.com</strong> with your order number.</p>\n        </div>\n        <div class=\"rp-tab-panel\" id=\"rp-tab-sizechart\">\n          <p>Please refer to our size guide for detailed measurements. Sizes run true to size — when in doubt, size up.</p>\n        </div>\n        <div class=\"rp-tab-panel\" id=\"rp-tab-care\">\n          <p>Machine wash cold with like colours. Tumble dry low. Do not bleach. Do not dry clean. Iron on low heat.</p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<script>\n  var rpImages = [\n    {%- for img in product.images -%}\n      \"{{ img | img_url: '1600x' }}\"{% unless forloop.last %},{% endunless %}\n    {%- endfor -%}\n  ];\n  var rpIdx = 0;\n\nfunction rpSetImg(i) {\n    rpIdx = (i + rpImages.length) % rpImages.length;\n    var el = document.getElementById('rp-main');\n    el.style.opacity = '0';\n    setTimeout(function() { el.src = rpImages[rpIdx]; el.style.opacity = '1'; }, 150);\n    document.getElementById('rp-counter').textContent = (rpIdx + 1) + ' / ' + rpImages.length;\n    document.querySelectorAll('.rp-thumb').forEach(function(t, idx) { t.classList.toggle('active', idx === rpIdx); });\n  }\n\n    document.getElementById('rp-counter').textContent = (rpIdx + 1) + ' / ' + rpImages.length;\n  }\n  function rpPrev() { rpSetImg(rpIdx - 1); }\n  function rpNext() { rpSetImg(rpIdx + 1); }\n\n  var rpWheelHandler = null;\n  var rpTouchHandler = null;\n  function rpLbOpen() {\n    var lb = document.getElementById('rp-lightbox');\n    var scrollY = window.scrollY || window.pageYOffset || 0;\n    document.body.dataset.rpScrollY = scrollY;\n    document.body.style.position = 'fixed';\n    document.body.style.top = -scrollY + 'px';\n    document.body.style.left = '0';\n    document.body.style.right = '0';\n    document.body.style.width = '100%';\n    document.body.style.overflow = 'hidden';\n    lb.classList.add('open');\n    lb.scrollTop = 0;\n    rpWheelHandler = function(e) { e.preventDefault(); lb.scrollTop += e.deltaY; };\n    document.addEventListener('wheel', rpWheelHandler, { passive: false });\n    rpTouchHandler = function(e) { if (!lb.contains(e.target)) e.preventDefault(); };\n    document.addEventListener('touchmove', rpTouchHandler, { passive: false });\n  }\n  function rpLbClose() {\n    document.getElementById('rp-lightbox').classList.remove('open');\n    var scrollY = parseInt(document.body.dataset.rpScrollY || '0', 10);\n    document.body.style.position = '';\n    document.body.style.top = '';\n    document.body.style.left = '';\n    document.body.style.right = '';\n    document.body.style.width = '';\n    document.body.style.overflow = '';\n    delete document.body.dataset.rpScrollY;\n    window.scrollTo(0, scrollY);\n    if (rpWheelHandler) { document.removeEventListener('wheel', rpWheelHandler, { passive: false }); rpWheelHandler = null; }\n    if (rpTouchHandler) { document.removeEventListener('touchmove', rpTouchHandler, { passive: false }); rpTouchHandler = null; }\n  }\n\n  function rpAccToggle(key, triggerEl) {\n    var body = document.getElementById('rp-acc-' + key);\n    var isOpen = body.classList.contains('open');\n    function pickDur(h) { return Math.min(1.2, 0.45 + h * 0.0011) + 's'; }\n    document.querySelectorAll('.rp-acc-body').forEach(function(b) {\n      if (b.classList.contains('open')) { b.style.transitionDuration = pickDur(b.scrollHeight); }\n      b.classList.remove('open');\n      b.style.maxHeight = '0px';\n    });\n    document.querySelectorAll('.rp-acc-trigger').forEach(function(t) { t.classList.remove('open'); });\n    if (!isOpen) {\n      body.classList.add('open');\n      triggerEl.classList.add('open');\n      var h = body.scrollHeight;\n      body.style.transitionDuration = pickDur(h);\n      body.style.maxHeight = h + 'px';\n    }\n  }\n\n  function rpTabSwitch(btn, key) {\n    var wrap = btn.closest('.rp-tabs-wrap');\n    wrap.querySelectorAll('.rp-tab-btn').forEach(function(b) { b.classList.remove('is-active'); });\n    wrap.querySelectorAll('.rp-tab-panel').forEach(function(p) { p.classList.remove('is-active'); });\n    btn.classList.add('is-active');\n    document.getElementById('rp-tab-' + key).classList.add('is-active');\n  }\n\n  function rpOpt(el, labelId) {\n    el.parentElement.querySelectorAll('.rp-swatch,.rp-swatch-plain').forEach(function(x) { x.classList.remove('active'); });\n    el.classList.add('active');\n    document.getElementById(labelId).textContent = el.dataset.val;\n    rpVariant();\n  }\n  function rpSize(el) {\n    document.getElementById('rp-sizes').querySelectorAll('.rp-size').forEach(function(x) { x.classList.remove('active'); });\n    el.classList.add('active');\n    rpVariant();\n  }\n  function rpVariant() {\n    var opts = [];\n    document.querySelectorAll('[data-oi].active').forEach(function(el) {\n      opts[parseInt(el.dataset.oi) - 1] = el.dataset.val;\n    });\n    var variants = {{ product.variants | json }};\n    var match = variants.find(function(v) {\n      return v.options.every(function(o, i) { return !opts[i] || o === opts[i]; });\n    });\n    if (match) document.getElementById('rp-vid').value = match.id;\n  }\n\n  function rpNisOpen() {\n    var activeSize = document.querySelector('#rp-sizes .rp-size.active');\n    var sel = document.getElementById('rp-nis-size');\n    if (activeSize && sel) sel.value = activeSize.dataset.val;\n    document.getElementById('rp-nis-modal').classList.add('open');\n  }\n  function rpNisClose() { document.getElementById('rp-nis-modal').classList.remove('open'); }\n  function rpNisClick(e) { if (e.target === document.getElementById('rp-nis-modal')) rpNisClose(); }\n  function rpNisSubmit() {\n    var email = document.getElementById('rp-nis-email').value.trim();\n    var size  = document.getElementById('rp-nis-size').value;\n    if (!email || !size) { alert('Please fill in all fields.'); return; }\n    document.getElementById('rp-nis-success').style.display = 'block';\n    document.getElementById('rp-nis-email').value = '';\n  }\n\n  (function() {\n    document.querySelectorAll('.rp-btn-cart, .rp-nis-submit').forEach(function(btn) {\n      btn.addEventListener('mousemove', function(e) {\n        var rect = btn.getBoundingClientRect();\n        btn.style.setProperty('--mx', (e.clientX - rect.left) + 'px');\n        btn.style.setProperty('--my', (e.clientY - rect.top) + 'px');\n        btn.style.setProperty('--mr', '240px');\n      });\n      btn.addEventListener('mouseleave', function() { btn.style.setProperty('--mr', '0px'); });\n    });\n  })();\n</script>\n\n<!-- ══════════════════════════════════════════════════════════\n     EDITORIAL SPLIT\n══════════════════════════════════════════════════════════ -->\n<style>\n  .rp-editorial {\n    display: grid; grid-template-columns: 1fr 1fr;\n    min-height: 70vh; font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;\n    border-top: 1px solid #d8d8d8;\n    background: linear-gradient(270deg, #ffffff 0%, #ffffff 55%, #e0e0e0 80%, #909090 100%);\n  }\n  .rp-editorial-text {\n    display: flex; flex-direction: column; justify-content: center;\n    padding: 80px 72px;\n  }\n  .rp-editorial-eyebrow {\n    font-size: 10px; font-weight: 700; letter-spacing: 0.18em;\n    text-transform: uppercase; color: #999; margin-bottom: 20px;\n  }\n  .rp-editorial-heading {\n    font-size: clamp(22px, 2.5vw, 34px); font-weight: 800;\n    letter-spacing: -0.03em; line-height: 1.1; color: #111; margin-bottom: 20px;\n  }\n  .rp-editorial-body {\n    font-size: 13px; font-weight: 400; line-height: 1.85;\n    color: #555; max-width: 360px; margin-bottom: 32px;\n  }\n  .rp-editorial-link {\n    display: inline-flex; align-items: center; gap: 8px;\n    font-size: 11px; font-weight: 700; letter-spacing: 0.14em;\n    text-transform: uppercase; color: #111; text-decoration: none;\n    border-bottom: 1px solid #111; padding-bottom: 2px; width: fit-content;\n  }\n  .rp-editorial-link:hover { opacity: 0.6; }\n  .rp-editorial-media { position: relative; overflow: hidden; background: #f0f0ee; }\n  .rp-editorial-media img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\n  .rp-section-label {\n    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;\n    font-size: 11px; font-weight: 900; letter-spacing: -0.02em;\n    text-transform: uppercase; color: #111; margin-bottom: 36px; text-align: center;\n  }\n  .rp-cards-section {\n    padding: 64px 48px; font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;\n    border-top: 1px solid #d8d8d8;\n    background: linear-gradient(270deg, #ffffff 0%, #ffffff 55%, #e0e0e0 80%, #909090 100%);\n  }\n  .rp-card-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n    gap: 24px;\n  }\n  .rp-product-card { display: flex; flex-direction: column; text-decoration: none; color: #111; }\n  .rp-product-card-img { width: 100%; aspect-ratio: 3/4; overflow: hidden; background: #f0f0ee; margin-bottom: 12px; }\n  .rp-product-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }\n  .rp-product-card:hover .rp-product-card-img img { transform: scale(1.04); }\n  .rp-product-card-name { font-size: 12px; font-weight: 700; letter-spacing: 0.02em; margin-bottom: 4px; }\n  .rp-product-card-sub { font-size: 11px; font-weight: 400; color: #888; margin-bottom: 6px; }\n  .rp-product-card-price { font-size: 12px; font-weight: 600; color: #111; }\n\n  @media (max-width: 768px) {\n    .rp-editorial { grid-template-columns: 1fr; }\n    .rp-editorial-text { padding: 48px 24px; }\n    .rp-editorial-media { min-height: 60vw; }\n    .rp-cards-section { padding: 48px 20px; }\n    .rp-card-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }\n  }\n</style>\n\n<section class=\"rp-editorial\">\n  <div class=\"rp-editorial-text\">\n    <p class=\"rp-editorial-eyebrow\">The Legacy Collection</p>\n    <h2 class=\"rp-editorial-heading\">Driven by Purpose.<br>Built to Last.</h2>\n    <p class=\"rp-editorial-body\">\n      Every piece in the LGCYCLOTHING legacy collection is crafted with intention.\n      Heavyweight construction, refined detailing and a fit designed to stand apart —\n      this is clothing for those who move with purpose. Worn by the few who understand\n      that quality is never an accident.\n    </p>\n    <a href=\"/collections/all\" class=\"rp-editorial-link\">Explore the Collection &rarr;</a>\n  </div>\n  <div class=\"rp-editorial-media\">\n    <img src=\"{{ product.featured_image | img_url: '1200x' }}\" alt=\"{{ product.title | escape }}\">\n  </div>\n</section>\n\n<section class=\"rp-cards-section\">\n  <h2 class=\"rp-section-label\">You May Also Like</h2>\n  <div class=\"rp-card-grid\">\n    {%- assign ymal_handles = 'driven-by-purpose-oversized-t-shirt,lgcy_black-purple' | split: ',' -%}\n    {%- for handle in ymal_handles -%}\n      {%- unless handle == product.handle -%}\n        {%- assign rec = all_products[handle] -%}\n        {%- if rec -%}\n          <a href=\"{{ rec.url }}\" class=\"rp-product-card\">\n            <div class=\"rp-product-card-img\">\n              <img src=\"{{ rec.featured_image | img_url: '800x' }}\" alt=\"{{ rec.title | escape }}\" loading=\"lazy\">\n            </div>\n            <span class=\"rp-product-card-name\">{{ rec.title }}</span>\n            <span class=\"rp-product-card-sub\">{{ rec.type }}</span>\n            <span class=\"rp-product-card-price\">{{ rec.price | money }}</span>\n          </a>\n        {%- endif -%}\n      {%- endunless -%}\n    {%- endfor -%}\n  </div>\n</section>\n\n<style>\n  .rp-header-hidden { transform: translateY(-100%) !important; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important; }\n  .rp-header-visible { transform: translateY(0) !important; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important; }\n</style>\n\n<script>\n(function() {\n  function getHeader() {\n    return (\n      document.querySelector('.shopify-section-group-header-group') ||\n      document.querySelector('#shopify-section-header') ||\n      document.querySelector('sticky-header') ||\n      document.querySelector('.header-wrapper') ||\n      document.querySelector('header[role=\"banner\"]') ||\n      document.querySelector('header')\n    );\n  }\n  var header = getHeader();\n  if (!header) return;\n  var style = window.getComputedStyle(header);\n  if (style.position === 'static') { header.style.position = 'relative'; }\n  header.style.transition = 'transform 0.35s cubic-bezier(0.4, 0, 0.2, 1)';\n  header.style.zIndex = '1000';\n  var lastScrollY = window.scrollY, ticking = false, SCROLL_THRESHOLD = 80, isHidden = false;\n  function onScroll() {\n    if (!ticking) {\n      window.requestAnimationFrame(function() {\n        var currentY = window.scrollY;\n        var diff = currentY - lastScrollY;\n        if (currentY < SCROLL_THRESHOLD) {\n          if (isHidden) { header.classList.remove('rp-header-hidden'); header.classList.add('rp-header-visible'); isHidden = false; }\n        } else if (diff > 4 && !isHidden) {\n          header.classList.remove('rp-header-visible'); header.classList.add('rp-header-hidden'); isHidden = true;\n        } else if (diff < -4 && isHidden) {\n          header.classList.remove('rp-header-hidden'); header.classList.add('rp-header-visible'); isHidden = false;\n        }\n        lastScrollY = currentY;\n        ticking = false;\n      });\n      ticking = true;\n    }\n  }\n  window.addEventListener('scroll', onScroll, { passive: true });\n})();\n</script>",
