y-content: space-between;\n    align-items: flex-start; margin-bottom: 22px;\n  }\n  .rp-title {\n    font-size: 16px; font-weight: 900;\n    letter-spacing: -0.04em; line-height: 1.2; color: #111;\n  }\n  .rp-price {\n    font-size: 14px; font-weight: 900; letter-spacing: -0.03em;\n    white-space: nowrap; margin-left: 20px; padding-top: 2px;\n  }\n\n  .rp-section { margin-bottom: 20px; }\n\n  .rp-color-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }\n  .rp-color-label {\n    font-size: 12px; font-weight: 800;\n    letter-spacing: 0.08em; text-transform: uppercase;\n  }\n  .rp-color-val { font-size: 12px; font-weight: 600; text-transform: capitalize; }\n  .rp-swatches { display: flex; gap: 3px; flex-wrap: wrap; }\n  .rp-swatch {\n    width: 54px; height: 68px; overflow: hidden; cursor: pointer;\n    outline: 1px solid transparent; outline-offset: 2px;\n    transition: outline 0.12s; flex-shrink: 0;\n  }\n  .rp-swatch img { width: 100%; height: 100%; object-fit: cover; display: block; }\n  .rp-swatch.active, .rp-swatch:hover { outline: 1px solid #111; }\n\n  .rp-size-header {\n    display: flex; justify-content: space-between;\n    align-items: center; margin-bottom: 8px;\n  }\n  .rp-size-label { font-size: 11px; font-weight: 900; letter-spacing: -0.03em; color: #444; }\n  .rp-size-guide {\n    font-size: 11px; font-weight: 900; letter-spacing: -0.03em; color: #444;\n    text-decoration: underline; background: none;\n    border: none; cursor: pointer; font-family: inherit;\n  }\n  .rp-sizes {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));\n    gap: 2px; margin-bottom: 8px;\n  }\n  .rp-size {\n    height: 44px; display: flex; align-items: center; justify-content: center;\n    font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;\n    font-size: 12px; font-weight: 900; letter-spacing: -0.02em; text-transform: uppercase;\n    cursor: pointer; background: #fff; border: none;\n    outline: 1px so