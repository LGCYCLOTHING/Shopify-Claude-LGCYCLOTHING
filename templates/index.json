{"sections":{"custom_liquid_rMJ6mW":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<p id=\"explore-label\" style=\"\n  position: fixed;\n  top: 60%;\n  left: 50%;\n  transform: translate(-50%, 140px);\n  z-index: 50;\n  font-family: 'Inter', Helvetica, Arial, sans-serif;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  color: #ffffff;\n  text-transform: uppercase;\n  margin: 0 0 6px 0;\n  padding: 0;\n  pointer-events: none;\n  line-height: 1;\n  text-align: center;\n  width: 90vw;\n  max-width: 600px;\n\">EXPLORE COLLECTIONS</p>\n\n<div id=\"scroll-indicator\" style=\"\n  position: fixed;\n  top: 62%;\n  left: 50%;\n  transform: translate(-50%, 140px);\n  z-index: 50;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0;\n  pointer-events: all;\n  text-align: center;\n  width: 90vw;\n  max-width: 600px;\n\">\n  <div style=\"height: 15px;\"></div>\n\n  <span class=\"scroll-label\" data-index=\"0\"\n    data-url=\"/collections/the-legacy-collection\"\n    style=\"\n    font-family: 'Inter', Helvetica, Arial, sans-serif;\n    font-size: clamp(18px, 3vw, 28px);\n    font-weight: 900;\n    letter-spacing: -0.03em;\n    color: rgba(255,255,255,1);\n    opacity: 1;\n    transition: color 0.4s ease, opacity 0.4s ease;\n    text-transform: uppercase;\n    cursor: pointer;\n    display: block;\n    position: relative;\n    line-height: 1.1;\n    margin: 0;\n    padding: 0;\n  \">ICONIC VISIONARY<span style=\"position:absolute;left:100%;top:50%;transform:translate(2px,-100%);font-size:0.42em;font-weight:700;letter-spacing:0.05em;color:rgba(255,255,255,0.55);white-space:nowrap;\">New</span></span>\n\n  <span class=\"scroll-label\" data-index=\"1\"\n    data-url=\"/collections/lgcy-glasses\"\n    style=\"\n    font-family: 'Inter', Helvetica, Arial, sans-serif;\n    font-size: clamp(18px, 3vw, 28px);\n    font-weight: 900;\n    letter-spacing: -0.03em;\n    color: rgba(255,255,255,0.3);\n    opacity: 0.5;\n    transition: color 0.4s ease, opacity 0.4s ease;\n    text-transform: uppercase;\n    cursor: pointer;\n    display: block;\n    line-height: 1.1;\n    margin: 0;\n    padding: 0;\n  \">LGCY.</span>\n\n  <div style=\"height: 48px;\"></div>\n  <a id=\"scroll-discover\" href=\"#\" style=\"margin-top: 48px;\">\u2192 DISCOVER</a>\n</div>\n\n<style>\n  /* \u2500\u2500\u2500 MOBILE CONTROLS \u2500\u2500\u2500 */\n  @media (max-width: 768px) {\n\n    /* Position of the whole indicator on mobile */\n    #scroll-indicator {\n      transform: translate(-50%, 48px) !important;\n      top: 62%; /* change this to move the block up/down */\n    }\n\n    #explore-label {\n      transform: translate(-50%, 48px) !important;\n      top: 60%; /* should match or sit just above scroll-indicator top */\n      font-size: 10px; /* \"EXPLORE COLLECTIONS\" font size on mobile */\n      letter-spacing: 0.12em;\n    }\n\n    /* Collection label font sizes on mobile */\n    .scroll-label {\n      font-size: 20px !important; /* overrides the clamp() */\n      letter-spacing: -0.02em !important;\n    }\n\n    /* \u2192 DISCOVER link on mobile */\n    #scroll-discover {\n      font-size: 10px !important;\n      letter-spacing: 0.0em !important;\n    }\n\n    /* Gap between collection labels and discover button */\n    #scroll-indicator > div:last-of-type {\n      height: 22px !important;\n    }\n  }\n\n  /* \u2500\u2500\u2500 DESKTOP STYLES \u2500\u2500\u2500 */\n  #scroll-discover {\n    font-family: 'Inter', Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    letter-spacing: 0.0em;\n    color: rgba(255,255,255,1);\n    text-transform: uppercase;\n    text-decoration: none;\n    margin: 0;\n    padding: 0 0 3px 0;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    line-height: 1;\n    position: relative;\n  }\n\n  #scroll-discover::after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    height: 1px;\n    background: rgba(255,255,255,1);\n    clip-path: inset(0 0 0 0%);\n  }\n\n  #scroll-discover:hover::after {\n    animation: lgcyUnderlineWipe 650ms ease;\n  }\n\n  @keyframes lgcyUnderlineWipe {\n    0%     { clip-path: inset(0 0 0 0%); }\n    50%    { clip-path: inset(0 0 0 100%); }\n    50.01% { clip-path: inset(0 100% 0 0); }\n    100%   { clip-path: inset(0 0% 0 0); }\n  }\n</style>\n\n<script>\n(function() {\n  function init() {\n    const labels = document.querySelectorAll('.scroll-label');\n    const discoverBtn = document.getElementById('scroll-discover');\n\n    let SWITCH_THRESHOLD = window.innerHeight * 0.3;\n\n    function safeNavigate(u) {\n      if (!u) return;\n      if (window.lgcyWipe) { window.lgcyWipe.navigate(u); } else { window.location.href = u; }\n    }\n\n    function scrollToSection(index) {\n      if (index === 0) {\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      } else {\n        var target = document.getElementById('glassesReveal');\n        if (target) { target.scrollIntoView({ behavior: 'smooth' }); }\n      }\n    }\n\n    function setActive(index) {\n      labels.forEach((label, i) => {\n        if (i === index) {\n          label.style.color = 'rgba(255,255,255,1)';\n          label.style.opacity = '1';\n        } else {\n          label.style.color = 'rgba(255,255,255,0.3)';\n          label.style.opacity = '0.5';\n        }\n      });\n      const url = labels[index] ? labels[index].getAttribute('data-url') : '#';\n      discoverBtn.href = url;\n    }\n\n    function update() {\n      const scrollY = window.scrollY;\n      if (scrollY > SWITCH_THRESHOLD) {\n        setActive(1);\n      } else {\n        setActive(0);\n      }\n    }\n\n    labels.forEach((label, i) => {\n      label.addEventListener('click', () => {\n        scrollToSection(i);\n      });\n    });\n\n    discoverBtn.addEventListener('click', function(e) {\n      e.preventDefault();\n      safeNavigate(discoverBtn.getAttribute('href'));\n    });\n\n    var videoBox = document.querySelector('.videoBox');\n    if (videoBox) {\n      videoBox.style.cursor = 'pointer';\n      videoBox.addEventListener('click', function(e) {\n        if (e.target.closest('#scroll-indicator') || e.target.closest('#explore-label')) return;\n        var activeIndex = Array.from(labels).findIndex(function(l) { return parseFloat(l.style.opacity) >= 1; });\n        scrollToSection(activeIndex === -1 ? 0 : activeIndex);\n      });\n    }\n\n    window.addEventListener('scroll', update, { passive: true });\n    window.addEventListener('resize', function() {\n      SWITCH_THRESHOLD = window.innerHeight * 0.3;\n    }, { passive: true });\n\n    update();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>","color_scheme":"","padding_top":0,"padding_bottom":0}},"lgcy_hero_explore":{"type":"lgcy-hero-explore","settings":{}},"custom_liquid_VVJUFg":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div id=\"hero-title\" style=\"\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 999;\n  mix-blend-mode: exclusion;\n  pointer-events: none;\n  text-align: center;\n  width: 90vw;\n  max-width: 100%;\n\">\n  <h1 style=\"\n    font-family: 'Inter', Helvetica, Arial, sans-serif;\n    font-size: clamp(28px, 8vw, 77px);\n    font-weight: 900;\n    letter-spacing: -3px;\n    color: #ffffff;\n    margin: 0;\n    padding: 0;\n    line-height: 1.1;\n    text-transform: uppercase;\n    mix-blend-mode: exclusion;\n    -webkit-mix-blend-mode: exclusion;\n    white-space: nowrap;\n  \">LGCYCLOTHING</h1>\n</div>\n<style>\n  @media (max-width: 768px) {\n    #hero-title h1 {\n      font-size: clamp(24px, 9.5vw, 45px) !important;\n      letter-spacing: -1.5px !important;\n      white-space: nowrap;\n    }\n  }\n</style>","color_sc