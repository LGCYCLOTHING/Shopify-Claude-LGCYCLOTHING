{%- comment -%}
  LGCY — Animated brand mark. A soft directional wipe sweeps across the real
  source image (tip -> tail), revealing its true color/gradient as it goes —
  reads like the swoosh is being drawn from point to tail in one motion.
  Plays once per browser session (sessionStorage-gated) and respects
  prefers-reduced-motion; falls back to the static full-color mark otherwise
  (including no-JS).

  Accepts: width, height, css_class, alt
{%- endcomment -%}
<div class="header__heading-logo-wrapper lgcy-logo-draw-wrapper" style="width: {{ width }}px; height: {{ height }}px;">
  <svg
    class="{{ css_class }} lgcy-logo-draw"
    viewBox="0 0 1200 1200"
    role="img"
    aria-label="{{ alt }}"
    width="{{ width }}"
    height="{{ height }}"
  >
    <defs>
      {%- comment -%} Axis runs from the tip (upper-right) to the tail (lower-left) {%- endcomment -%}
      <linearGradient id="lgcy-logo-wipe-{{ section.id }}" gradientUnits="userSpaceOnUse" x1="1127" y1="400" x2="54" y2="793">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop class="lgcy-logo-draw__edge1" offset="0" stop-color="#ffffff"></stop>
        <stop class="lgcy-logo-draw__edge2" offset="0.035" stop-color="#000000"></stop>
        <stop offset="1" stop-color="#000000"></stop>
      </linearGradient>
      <mask id="lgcy-logo-mask-{{ section.id }}" maskUnits="userSpaceOnUse" x="-200" y="-200" width="1600" height="1600">
        <rect x="-200" y="-200" width="1600" height="1600" fill="url(#lgcy-logo-wipe-{{ section.id }})"></rect>
      </mask>
    </defs>
    <image
      class="lgcy-logo-draw__fill"
      data-mask-id="lgcy-logo-mask-{{ section.id }}"
      href="https://cdn.shopify.com/s/files/1/0688/4537/1578/files/Untitled_Project_-_Standard_6.svg"
      x="0"
      y="0"
      width="1200"
      height="1200"
      preserveAspectRatio="xMidYMid meet"
    ></image>
  </svg>
  <script>
    (function () {
      var wrapper = document.currentScript.parentElement;
      var fillImg = wrapper.querySelector('.lgcy-logo-draw__fill');
      var edge1 = wrapper.querySelector('.lgcy-logo-draw__edge1');
      var edge2 = wrapper.querySelector('.lgcy-logo-draw__edge2');
      if (!fillImg || !edge1 || !edge2) return;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var played = false;
      try { played = sessionStorage.getItem('lgcyLogoIntroPlayed') === '1'; } catch (e) {}

      if (reduceMotion || played) return; // default state already shows the full-color mark, unmasked

      var maskId = fillImg.getAttribute('data-mask-id');
      fillImg.setAttribute('mask', 'url(#' + maskId + ')');

      var duration = 1500;
      var band = 0.035;
      var start = null;

      function ease(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function frame(ts) {
        if (start === null) start = ts;
        var raw = Math.min((ts - start) / duration, 1);
        var p = ease(raw);
        edge1.setAttribute('offset', p);
        edge2.setAttribute('offset', Math.min(p + band, 1));
        if (raw < 1) {
          requestAnimationFrame(frame);
        } else {
          fillImg.removeAttribute('mask');
        }
      }
      requestAnimationFrame(frame);

      try { sessionStorage.setItem('lgcyLogoIntroPlayed', '1'); } catch (e) {}
    })();
  </script>
</div>

<style>
  .lgcy-logo-draw-wrapper {
    display: inline-flex;
  }
  .lgcy-logo-draw {
    overflow: visible;
    display: block;
  }
  .lgcy-logo-draw__fill {
    opacity: 1;
  }
</style>
