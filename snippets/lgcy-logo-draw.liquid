{%- comment -%}
  LGCY — Animated brand mark. A visible pen-line outline and a soft color
  reveal both travel together along a smooth guide curve: starts at the
  inner cusp, sweeps up and around the tip, then down to the tail (no sharp
  corners — built as a Catmull-Rom spline through those three points).
  The outline fades out once the reveal completes. Plays once per browser
  session (sessionStorage-gated) and respects prefers-reduced-motion; falls
  back to the static full-color mark otherwise (including no-JS).

  Accepts: width, height, css_class, alt
{%- endcomment -%}
<div class="header__heading-logo-wrapper lgcy-logo-draw-wrapper" style="width: {{ width }}px; height: {{ height }}px;">
  <svg
    class="{{ css_class }} lgcy-logo-draw"
    viewBox="0 0 1200 1200"
    role="img"
    aria-label="{{ alt }}"
    width="{{ width }}"
    height="{{ height }}"
  >
    <defs>
      <filter id="lgcy-logo-soft-{{ section.id }}" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="14"></feGaussianBlur>
      </filter>
      <mask id="lgcy-logo-mask-{{ section.id }}" maskUnits="userSpaceOnUse" x="-400" y="-400" width="2000" height="2000">
        <path
          class="lgcy-logo-draw__reveal"
          d="M 610,476 C 696.17,463.33 1219.67,347.17 1127,400 C 1034.33,452.83 232.83,727.5 54,793"
          fill="none"
          stroke="#ffffff"
          stroke-width="380"
          stroke-linecap="round"
          filter="url(#lgcy-logo-soft-{{ section.id }})"
        ></path>
      </mask>
    </defs>
    <image
      class="lgcy-logo-draw__fill"
      data-mask-id="lgcy-logo-mask-{{ section.id }}"
      href="https://cdn.shopify.com/s/files/1/0688/4537/1578/files/Untitled_Project_-_Standard_6.svg"
      x="0"
      y="0"
      width="1200"
      height="1200"
      preserveAspectRatio="xMidYMid meet"
    ></image>
    <path
      class="lgcy-logo-draw__outline"
      d="M 610,476 C 696.17,463.33 1219.67,347.17 1127,400 C 1034.33,452.83 232.83,727.5 54,793"
      fill="none"
      stroke="currentColor"
      stroke-width="6"
      stroke-linecap="round"
    ></path>
  </svg>
  <script>
    (function () {
      var wrapper = document.currentScript.parentElement;
      var fillImg = wrapper.querySelector('.lgcy-logo-draw__fill');
      var reveal = wrapper.querySelector('.lgcy-logo-draw__reveal');
      var outline = wrapper.querySelector('.lgcy-logo-draw__outline');
      if (!fillImg || !reveal || !outline || !outline.getTotalLength) return;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var played = false;
      try { played = sessionStorage.getItem('lgcyLogoIntroPlayed') === '1'; } catch (e) {}

      if (reduceMotion || played) return; // default state already shows the full-color mark, unmasked

      var maskId = fillImg.getAttribute('data-mask-id');
      fillImg.setAttribute('mask', 'url(#' + maskId + ')');

      var len = outline.getTotalLength();
      outline.style.strokeDasharray = len;
      outline.style.strokeDashoffset = len;
      outline.style.opacity = '1';

      var duration = 1500;
      var start = null;

      function ease(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function frame(ts) {
        if (start === null) start = ts;
        var raw = Math.min((ts - start) / duration, 1);
        var p = ease(raw);
        var offset = len * (1 - p);
        reveal.style.strokeDasharray = len;
        reveal.style.strokeDashoffset = offset;
        outline.style.strokeDashoffset = offset;
        if (raw < 1) {
          requestAnimationFrame(frame);
        } else {
          fillImg.removeAttribute('mask');
          outline.style.transition = 'opacity 0.4s ease';
          outline.style.opacity = '0';
        }
      }
      requestAnimationFrame(frame);

      try { sessionStorage.setItem('lgcyLogoIntroPlayed', '1'); } catch (e) {}
    })();
  </script>
</div>

<style>
  .lgcy-logo-draw-wrapper {
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }
  .lgcy-logo-draw {
    overflow: visible;
    display: block;
  }
  .lgcy-logo-draw__fill {
    opacity: 1;
  }
  .lgcy-logo-draw__outline {
    opacity: 0;
  }
</style>
