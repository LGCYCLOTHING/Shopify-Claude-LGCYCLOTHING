{%- comment -%}
  LGCY — Animated brand mark. A soft radial wedge sweeps out from the cusp
  where the inner accent line begins, arcing around through the body of the
  mark, revealing the real source image's true color/gradient as it goes.
  Plays once per browser session (sessionStorage-gated) and respects
  prefers-reduced-motion; falls back to the static full-color mark otherwise
  (including no-JS).

  Accepts: width, height, css_class, alt
{%- endcomment -%}
<div class="header__heading-logo-wrapper lgcy-logo-draw-wrapper" style="width: {{ width }}px; height: {{ height }}px;">
  <svg
    class="{{ css_class }} lgcy-logo-draw"
    viewBox="0 0 1200 1200"
    role="img"
    aria-label="{{ alt }}"
    width="{{ width }}"
    height="{{ height }}"
  >
    <defs>
      <filter id="lgcy-logo-soft-{{ section.id }}" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="10"></feGaussianBlur>
      </filter>
      <mask id="lgcy-logo-mask-{{ section.id }}" maskUnits="userSpaceOnUse" x="-400" y="-400" width="2000" height="2000">
        <path class="lgcy-logo-draw__wedge" fill="#ffffff" filter="url(#lgcy-logo-soft-{{ section.id }})"></path>
      </mask>
    </defs>
    <image
      class="lgcy-logo-draw__fill"
      data-mask-id="lgcy-logo-mask-{{ section.id }}"
      href="https://cdn.shopify.com/s/files/1/0688/4537/1578/files/Untitled_Project_-_Standard_6.svg"
      x="0"
      y="0"
      width="1200"
      height="1200"
      preserveAspectRatio="xMidYMid meet"
    ></image>
  </svg>
  <script>
    (function () {
      var wrapper = document.currentScript.parentElement;
      var fillImg = wrapper.querySelector('.lgcy-logo-draw__fill');
      var wedge = wrapper.querySelector('.lgcy-logo-draw__wedge');
      if (!fillImg || !wedge) return;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var played = false;
      try { played = sessionStorage.getItem('lgcyLogoIntroPlayed') === '1'; } catch (e) {}

      if (reduceMotion || played) return; // default state already shows the full-color mark, unmasked

      // Anchor: the cusp where the inner accent line begins (upper-middle of the mark).
      var cx = 610;
      var cy = 476;
      var radius = 1600;
      var startAngle = -14; // toward the tip
      var endAngle = 156; // arcs down and around toward the tail

      function point(angleDeg) {
        var rad = (angleDeg * Math.PI) / 180;
        return [cx + radius * Math.cos(rad), cy + radius * Math.sin(rad)];
      }

      function wedgePath(currentAngle) {
        var p1 = point(startAngle);
        var p2 = point(currentAngle);
        var span = currentAngle - startAngle;
        var largeArc = span > 180 ? 1 : 0;
        return (
          'M ' + cx + ',' + cy +
          ' L ' + p1[0] + ',' + p1[1] +
          ' A ' + radius + ',' + radius + ' 0 ' + largeArc + ' 1 ' + p2[0] + ',' + p2[1] +
          ' Z'
        );
      }

      var maskId = fillImg.getAttribute('data-mask-id');
      fillImg.setAttribute('mask', 'url(#' + maskId + ')');
      wedge.setAttribute('d', wedgePath(startAngle));

      var duration = 1500;
      var start = null;

      function ease(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function frame(ts) {
        if (start === null) start = ts;
        var raw = Math.min((ts - start) / duration, 1);
        var p = ease(raw);
        var angle = startAngle + (endAngle - startAngle) * p;
        wedge.setAttribute('d', wedgePath(angle));
        if (raw < 1) {
          requestAnimationFrame(frame);
        } else {
          fillImg.removeAttribute('mask');
        }
      }
      requestAnimationFrame(frame);

      try { sessionStorage.setItem('lgcyLogoIntroPlayed', '1'); } catch (e) {}
    })();
  </script>
</div>

<style>
  .lgcy-logo-draw-wrapper {
    display: inline-flex;
  }
  .lgcy-logo-draw {
    overflow: visible;
    display: block;
  }
  .lgcy-logo-draw__fill {
    opacity: 1;
  }
</style>
