{%- comment -%}
  LGCY — Animated brand mark. A soft reveal travels along a guide curve from
  the tip, through the bend, down to the tail — following the swoosh's own
  spine — while progressively revealing the real source image's true color/
  gradient. Plays once per browser session (sessionStorage-gated) and
  respects prefers-reduced-motion; falls back to the static full-color mark
  otherwise (including no-JS).

  Accepts: width, height, css_class, alt
{%- endcomment -%}
<div class="header__heading-logo-wrapper lgcy-logo-draw-wrapper" style="width: {{ width }}px; height: {{ height }}px;">
  <svg
    class="{{ css_class }} lgcy-logo-draw"
    viewBox="0 0 1200 1200"
    role="img"
    aria-label="{{ alt }}"
    width="{{ width }}"
    height="{{ height }}"
  >
    <defs>
      <filter id="lgcy-logo-soft-{{ section.id }}" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="14"></feGaussianBlur>
      </filter>
      <mask id="lgcy-logo-mask-{{ section.id }}" maskUnits="userSpaceOnUse" x="-400" y="-400" width="2000" height="2000">
        <path
          class="lgcy-logo-draw__guide"
          d="M 1127,400 Q 610,476 54,793"
          fill="none"
          stroke="#ffffff"
          stroke-width="380"
          stroke-linecap="round"
          filter="url(#lgcy-logo-soft-{{ section.id }})"
        ></path>
      </mask>
    </defs>
    <image
      class="lgcy-logo-draw__fill"
      data-mask-id="lgcy-logo-mask-{{ section.id }}"
      href="https://cdn.shopify.com/s/files/1/0688/4537/1578/files/Untitled_Project_-_Standard_6.svg"
      x="0"
      y="0"
      width="1200"
      height="1200"
      preserveAspectRatio="xMidYMid meet"
    ></image>
  </svg>
  <script>
    (function () {
      var wrapper = document.currentScript.parentElement;
      var fillImg = wrapper.querySelector('.lgcy-logo-draw__fill');
      var guide = wrapper.querySelector('.lgcy-logo-draw__guide');
      if (!fillImg || !guide || !guide.getTotalLength) return;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var played = false;
      try { played = sessionStorage.getItem('lgcyLogoIntroPlayed') === '1'; } catch (e) {}

      if (reduceMotion || played) return; // default state already shows the full-color mark, unmasked

      var maskId = fillImg.getAttribute('data-mask-id');
      fillImg.setAttribute('mask', 'url(#' + maskId + ')');

      var len = guide.getTotalLength();
      guide.style.strokeDasharray = len;
      guide.style.strokeDashoffset = len;

      var duration = 1500;
      var start = null;

      function ease(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function frame(ts) {
        if (start === null) start = ts;
        var raw = Math.min((ts - start) / duration, 1);
        var p = ease(raw);
        guide.style.strokeDashoffset = len * (1 - p);
        if (raw < 1) {
          requestAnimationFrame(frame);
        } else {
          fillImg.removeAttribute('mask');
        }
      }
      requestAnimationFrame(frame);

      try { sessionStorage.setItem('lgcyLogoIntroPlayed', '1'); } catch (e) {}
    })();
  </script>
</div>

<style>
  .lgcy-logo-draw-wrapper {
    display: inline-flex;
  }
  .lgcy-logo-draw {
    overflow: visible;
    display: block;
  }
  .lgcy-logo-draw__fill {
    opacity: 1;
  }
</style>
