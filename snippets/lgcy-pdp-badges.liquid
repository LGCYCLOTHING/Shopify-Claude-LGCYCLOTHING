  <span class="lgcy-pdp-bluelight-badge" role="note" aria-label="Blue light filter lens">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3.5"/>
      <path d="M12 2v2"/>
      <path d="M12 20v2"/>
      <path d="m4.93 4.93 1.41 1.41"/>
      <path d="m17.66 17.66 1.41 1.41"/>
      <path d="M2 12h2"/>
      <path d="M20 12h2"/>
      <path d="m4.93 19.07 1.41-1.41"/>
      <path d="m17.66 6.34 1.41-1.41"/>
    </svg>
    <span>Blue Light Filter</span>
  </span>
</template>

<style>
  /* === NEW badge — sits tight next to product title === */
  .lgcy-pdp-new-badge {
    --border-width: 1px;
    position: relative;
    display: inline-flex;
    align-items: center;
    isolation: isolate;
    margin-left: 10px;
    /* Push the price to the far right — keeps badge glued to title in the
       rp-header flex row (justify-content: space-between). */
    margin-right: auto;
    padding: 5px 10px;
    border-radius: 6px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 900;
    font-size: 10px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #000;
    background: linear-gradient(
      -75deg,
      rgba(255, 255, 255, 0.55),
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.55)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12),
      0 0.2em 0.4em -0.1em rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(0, 0, 0, 0.08);
    -webkit-backdrop-filter: blur(6px) saturate(140%);
            backdrop-filter: blur(6px) saturate(140%);
    line-height: 1;
    vertical-align: middle;
    white-space: nowrap;
  }
  .lgcy-pdp-new-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 6px;
    width: calc(100% + var(--border-width));
    height: calc(100% + var(--border-width));
    top: calc(0% - var(--border-width) / 2);
    left: calc(0% - var(--border-width) / 2);
    padding: var(--border-width);
    box-sizing: border-box;
    background: conic-gradient(
      from -75deg at 50% 50%,
      rgba(0, 0, 0, 0.4),
      rgba(0, 0, 0, 0) 5% 40%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0) 60% 95%,
      rgba(0, 0, 0, 0.4)
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  /* === BLUE LIGHT FILTER badge — bottom-right of the Product Details box === */
  .lgcy-pdp-bluelight-badge {
    --border-width: 1px;
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 14;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    isolation: isolate;
    padding: 6px 10px;
    border-radius: 8px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 900;
    font-size: 9px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #0a3a6b;
    background: linear-gradient(
      -75deg,
      rgba(200, 222, 245, 0.6),
      rgba(225, 238, 252, 0.88),
      rgba(200, 222, 245, 0.6)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(20, 60, 110, 0.15),
      0 0.3em 0.7em -0.15em rgba(20, 60, 110, 0.25),
      0 0 0 1px rgba(20, 60, 110, 0.08);
    -webkit-backdrop-filter: blur(10px) saturate(150%);
            backdrop-filter: blur(10px) saturate(150%);
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 360ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 360ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lgcy-pdp-bluelight-badge.is-shown {
    opacity: 1;
    transform: translateY(0);
  }
  .lgcy-pdp-bluelight-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 8px;
    width: calc(100% + var(--border-width));
    height: calc(100% + var(--border-width));
    top: calc(0% - var(--border-width) / 2);
    left: calc(0% - var(--border-width) / 2);
    padding: var(--border-width);
    box-sizing: border-box;
    background: conic-gradient(
      from -75deg at 50% 50%,
      rgba(20, 60, 110, 0.45),
      rgba(20, 60, 110, 0) 5% 40%,
      rgba(20, 60, 110, 0.45) 50%,
      rgba(20, 60, 110, 0) 60% 95%,
      rgba(20, 60, 110, 0.45)
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }
  .lgcy-pdp-bluelight-badge svg {
    color: #0a3a6b;
    flex-shrink: 0;
  }

  @media (max-width: 749px) {
    .lgcy-pdp-new-badge {
      font-size: 9px;
      margin-left: 8px;
      padding: 4px 8px;
    }
    .lgcy-pdp-bluelight-badge {
      bottom: 8px;
      right: 8px;
      padding: 5px 9px;
      font-size: 8px;
      border-radius: 8px;
    }
    .lgcy-pdp-bluelight-badge::after {
      border-radius: 8px;
    }
  }
</style>

<script>
  (function () {
    var tagsMeta = document.querySelector('meta[name="lgcy-product-tags"]');
    var tags = tagsMeta ? (tagsMeta.getAttribute('content') || '').split(',').map(function (t) {
      return t.trim().toLowerCase();
    }) : [];
    var isBlueLight = tags.indexOf('blue-light') !== -1 ||
                      tags.indexOf('bluelight') !== -1 ||
                      tags.indexOf('blue light') !== -1;

    var newTpl = document.getElementById('lgcy-pdp-new-template');
    var blTpl  = document.getElementById('lgcy-pdp-bluelight-template');

    var TITLE_SELECTORS = ['.rp-title', '.product__title', 'h1.product-title', 'h1[itemprop="name"]'];
    var DETAILS_SELECTORS = ['#rp-acc-details', '.rp-gallery', '.product__media-wrapper', '.product__media-list', 'media-gallery', '.product-media-container'];

    function findFirst(sels) {
      for (var i = 0; i < sels.length; i++) {
        var el = document.querySelector(sels[i]);
        if (el) return el;
      }
      return null;
    }

    function injectNewBadge() {
      if (document.querySelector('.lgcy-pdp-new-badge')) return true;
      var title = findFirst(TITLE_SELECTORS);
      if (!title || !newTpl) return false;
      var badge = newTpl.content.firstElementChild.cloneNode(true);
      /* Insert AFTER the title element (not inside it) so dynamic
         breadcrumbs reading h1.textContent don't pick up "NEW". */
      if (title.parentNode) {
        title.parentNode.insertBefore(badge, title.nextSibling);
      } else {
        title.appendChild(badge);
      }
      return true;
    }

    function injectBlueLight() {
      if (!isBlueLight) return true;
      if (document.querySelector('.lgcy-pdp-bluelight-badge')) return true;
      var host = findFirst(DETAILS_SELECTORS);
      if (!host || !blTpl) return false;
      if (getComputedStyle(host).position === 'static') {
        host.style.position = 'relative';
      }
      var badge = blTpl.content.firstElementChild.cloneNode(true);
      host.appendChild(badge);
      requestAnimationFrame(function () { badge.classList.add('is-shown'); });
      return true;
    }

    function tick() {
      var a = injectNewBadge();
      var b = injectBlueLight();
      return a && b;
    }

    if (tick()) return;
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      if (tick() || tries >= 30) clearInterval(t);
    }, 250);
  })();
</script>

<script>
  /* PDP — move Instafeed above "You May Also Like" + pass wheel events
     through Instafeed so vertical scroll keeps moving the page. */
  (function () {
    function move() {
      var instaFeed = document.querySelector('#insta-feed, .instafeed-shopify');
      if (!instaFeed) return false;
      var instaSection = instaFeed.closest('.shopify-section');
      if (!instaSection) return false;
      var cardsSection = document.querySelector('.rp-cards-section');
      if (!cardsSection) return false;
      if (instaSection.nextElementSibling === cardsSection ||
          cardsSection.previousElementSibling === instaSection) {
        attachWheel(instaSection);
        return true;
      }
      cardsSection.parentNode.insertBefore(instaSection, cardsSection);
      attachWheel(instaSection);
      return true;
    }

    function attachWheel(instaSection) {
      if (instaSection.dataset.lgcyWheelFixed === '1') return;
      instaSection.dataset.lgcyWheelFixed = '1';
      /* Mintt's wheel handler hijacks scroll to drive its horizontal slider.
         We intercept earlier (capture phase) and translate vertical wheel
         into a page scroll, then stop the event so Mintt can't grab it. */
      instaSection.addEventListener('wheel', function (e) {
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return; // let horizontal pass
        window.scrollBy({ top: e.deltaY, left: 0, behavior: 'auto' });
        e.stopPropagation();
        if (e.cancelable) e.preventDefault();
      }, { capture: true, passive: false });
    }

    if (move()) return;
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      if (move() || tries >= 40) clearInterval(t);
    }, 250);
  })();
</script>

<style>
  /* Stock status pill — retired everywhere now that the Product Details
     description box has its own permanent green/red dot + In Stock/Sold Out
     line covering the same info (see updateAvailabilityLine below). Still
     built by the JS below (harmless), just hidden. */
  #lgcy-stock-pill {
    display: none !important;
  }
  @media (min-width: 861px) {
    .rp-size-dot {
      display: none !important;
    }
  }
</style>

<script>
  /* Stock status pill — injected via JS so it works on any product template.
     Exposes window.lgcyUpdateStockPill(available, qty) so the variant
     picker (rpVariant() in lgcy-product-page.liquid) can refresh it when
     the shopper switches size/color — the initial render only reflects
     product.selected_or_first_available_variant, which goes stale the
     moment a different variant with different stock is selected. */
  (function () {
    function styleFor(available, qty) {
      if (document.querySelector('meta[name="lgcy-product-coming-soon"]')) {
        return {
          dotColor: '#8a8a8a', label: 'Coming Soon',
          bg: 'linear-gradient(-75deg,rgba(138,138,138,0.20),rgba(138,138,138,0.35),rgba(138,138,138,0.20))',
          shadow: 'inset 0 1px 0 rgba(255,255,255,0.8),inset 0 -1px 0 rgba(90,90,90,0.25),0 0.25em 0.5em -0.125em rgba(90,90,90,0.20),0 0 0 1px rgba(90,90,90,0.35)'
        };
      }
      if (!available) {
        return {
          dotColor: '#ef4444', label: 'Out of Stock',
          bg: 'linear-gradient(-75deg,rgba(239,68,68,0.20),rgba(239,68,68,0.35),rgba(239,68,68,0.20))',
          shadow: 'inset 0 1px 0 rgba(255,255,255,0.8),inset 0 -1px 0 rgba(180,40,40,0.25),0 0.25em 0.5em -0.125em rgba(180,40,40,0.20),0 0 0 1px rgba(180,40,40,0.35)'
        };
      }
      if (qty > 0 && qty <= 25) {
        return {
          dotColor: '#f67637', label: 'Limited Stock',
          bg: 'linear-gradient(-75deg,rgba(246,118,55,0.20),rgba(246,118,55,0.35),rgba(246,118,55,0.20))',
          shadow: 'inset 0 1px 0 rgba(255,255,255,0.8),inset 0 -1px 0 rgba(178,80,34,0.25),0 0.25em 0.5em -0.125em rgba(178,80,34,0.20),0 0 0 1px rgba(178,80,34,0.35)'
        };
      }
      return {
        dotColor: '#22c55e', label: 'In Stock',
        bg: 'linear-gradient(-75deg,rgba(34,197,94,0.20),rgba(34,197,94,0.35),rgba(34,197,94,0.20))',
        shadow: 'inset 0 1px 0 rgba(255,255,255,0.8),inset 0 -1px 0 rgba(22,130,60,0.25),0 0.25em 0.5em -0.125em rgba(22,130,60,0.20),0 0 0 1px rgba(22,130,60,0.35)'
      };
    }

    function render(pill, s) {
      pill.style.background = s.bg;
      pill.style.boxShadow = s.shadow;
      pill.querySelector('.lgcy-stock-dot').style.background = s.dotColor;
      pill.querySelector('.lgcy-stock-label').textContent = s.label;
    }

    function inject(available, qty) {
      var existing = document.getElementById('lgcy-stock-pill');
      if (existing) { render(existing, styleFor(available, qty)); return true; }

      var accList = document.querySelector('.rp-acc-list');
      if (!accList) return false;

      var s = styleFor(available, qty);
      var pill = document.createElement('div');
      pill.id = 'lgcy-stock-pill';
      pill.style.cssText =
        'display:inline-flex;align-items:center;gap:5px;' +
        'padding:3px 8px 3px 6px;border-radius:999px;' +
        'background:' + s.bg + ';box-shadow:' + s.shadow + ';' +
        'margin-top:10px;width:fit-content;position:relative;isolation:isolate;';
      pill.style.webkitBackdropFilter = 'blur(8px) saturate(140%)';
      pill.style.backdropFilter = 'blur(8px) saturate(140%)';

      var dot = document.createElement('span');
      dot.className = 'lgcy-stock-dot';
      dot.style.cssText = 'width:6px;height:6px;border-radius:50%;flex-shrink:0;background:' + s.dotColor + ';';

      var txt = document.createElement('span');
      txt.className = 'lgcy-stock-label';
      txt.style.cssText = 'font-size:9px;font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;color:#1a1a1a;font-family:Helvetica,Arial,sans-serif;';
      txt.textContent = s.label;

      pill.appendChild(dot);
      pill.appendChild(txt);

      accList.parentNode.insertBefore(pill, accList.nextSibling);
      return true;
    }

    /* Mobile-only equivalent — instead of the desktop pill, a small dot is
       appended to the right of the letter on whichever size button is
       currently selected. Rebuilt on every call since the "selected" button
       changes as the shopper taps sizes.

       Below 860px the real .rp-size buttons are hidden (component-glassy-cta.css)
       and theme.liquid mirrors them into .lgcy-sticky-atc__size pills in a fixed
       bottom bar — that mirror is what shoppers actually see and tap on mobile,
       so the dot has to go there. The mirror's own "is-active" class is kept in
       sync by a MutationObserver in theme.liquid that fires asynchronously, so
       matching on it here would race the sync; matching by index (pills are
       created in the same order as the original buttons) is instant instead. */
    function updateSizeDot(available, qty) {
      var old = document.querySelector('.rp-size-dot');
      if (old) old.remove();

      var origSizes = document.querySelectorAll('#rp-sizes .rp-size');
      var activeSize = document.querySelector('#rp-sizes .rp-size.active');
      if (!activeSize) return;

      var idx = Array.prototype.indexOf.call(origSizes, activeSize);
      var mirrorPills = document.querySelectorAll('.lgcy-sticky-atc__size');
      var target = mirrorPills[idx] || activeSize;

      var s = styleFor(available, qty);
      var dot = document.createElement('span');
      dot.className = 'rp-size-dot';
      /* Absolutely positioned so it never nudges the centered letter — the
         button already has position:relative (component-glassy-cta.css).
         Anchored off the horizontal center (where the letter sits) rather
         than the button's edge, so it stays snug next to the letter even
         on wider pills instead of drifting off toward the right edge. */
      dot.style.cssText = 'position:absolute;top:50%;left:calc(50% + 7px);transform:translateY(-50%);width:6px;height:6px;border-radius:50%;background:' + s.dotColor + ';';
      target.appendChild(dot);
    }

    /* Permanent 4th line in the Product Details box — a colored dot plus
       "In Stock" / "Sold Out" for whichever size is currently selected
       (or the default variant before any size has been touched). Text
       keeps the same weight as the rest of the description; only the
       dot and the label pick up the green/red. */
    function updateAvailabilityLine(available) {
      var body = document.querySelector('#rp-acc-details .rp-acc-body-inner');
      if (!body) return;

      /* Coming Soon products: no stock status line at all here — the page
         already reads "Coming Soon" on the Add to Cart button, and showing
         a status line (even relabeled) here reads as misleading. */
      var isComingSoon = !!document.querySelector('meta[name="lgcy-product-coming-soon"]');
      if (isComingSoon) {
        var existing = document.getElementById('lgcy-availability-line');
        if (existing) existing.remove();
        return;
      }

      var color = available ? '#16a34a' : '#dc2626';
      var label = available ? 'In Stock' : 'Sold Out';

      var p = document.getElementById('lgcy-availability-line');
      if (!p) {
        p = document.createElement('p');
        p.id = 'lgcy-availability-line';
        p.style.cssText = 'display:flex;align-items:center;gap:7px;';

        var dot = document.createElement('span');
        dot.className = 'lgcy-availability-dot';
        dot.style.cssText = 'display:inline-block;width:7px;height:7px;border-radius:50%;flex-shrink:0;';

        var labelSpan = document.createElement('span');
        labelSpan.className = 'lgcy-availability-label';

        p.appendChild(dot);
        p.appendChild(labelSpan);
        body.appendChild(p);
      }

      p.querySelector('.lgcy-availability-dot').style.background = color;
      var labelEl = p.querySelector('.lgcy-availability-label');
      labelEl.style.color = color;
      labelEl.textContent = label;
    }

    window.lgcyUpdateStockPill = function (available, qty) {
      inject(available, qty);
      updateSizeDot(available, qty);
      updateAvailabilityLine(available);
    };

    var availMeta = document.querySelector('meta[name="lgcy-variant-available"]');
    var invMeta   = document.querySelector('meta[name="lgcy-variant-inventory"]');
    if (!availMeta) return;

    var available = availMeta.getAttribute('content') === 'true';
    var qty       = parseInt(invMeta ? invMeta.getAttribute('content') : '0', 10);

    updateSizeDot(available, qty);
    updateAvailabilityLine(available);
    if (inject(available, qty)) return;
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      updateSizeDot(available, qty);
      updateAvailabilityLine(available);
      if (inject(available, qty) || tries >= 40) clearInterval(t);
    }, 250);
  })();
</script>

<style>
  /* === You May Also Like — center the cards === */
  .rp-card-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(220px, 280px)) !important;
    justify-content: center !important;
    gap: 24px !important;
    max-width: 1000px !important;
    margin: 0 auto !important;
  }
  @media (max-width: 768px) {
    .rp-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      max-width: none !important;
    }
  }
</style>

<script>
  /* PDP — fill "You May Also Like" with recommendations when the
     hardcoded list shows fewer than 2 cards. */
  (function () {
    function fill() {
      var grid = document.querySelector('.rp-card-grid');
      if (!grid) return false;
      if (grid.children.length >= 2) return true;
      if (grid.dataset.lgcyFilling === '1') return true;

      var idMeta = document.querySelector('meta[name="lgcy-product-id"]');
      if (!idMeta) return false;
      var productId = idMeta.getAttribute('content');
      if (!productId) return false;

      grid.dataset.lgcyFilling = '1';

      var existing = new Set();
      grid.querySelectorAll('a').forEach(function (a) {
        var m = a.getAttribute('href') || '';
        var match = m.match(/\/products\/([^/?#]+)/);
        if (match) existing.add(match[1]);
      });

      fetch('/recommendations/products.json?product_id=' + encodeURIComponent(productId) + '&limit=6&intent=related')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || !Array.isArray(data.products)) return;
          var needed = 2 - grid.children.length;
          for (var i = 0; i < data.products.length && needed > 0; i++) {
            var p = data.products[i];
            if (!p || !p.handle || existing.has(p.handle)) continue;
            existing.add(p.handle);
            grid.appendChild(buildCard(p));
            needed--;
          }
        })
        .catch(function () { grid.dataset.lgcyFilling = ''; });

      return true;
    }

    function buildCard(p) {
      var a = document.createElement('a');
      a.href = p.url || ('/products/' + p.handle);
      a.className = 'rp-product-card';

      var imgUrl = p.featured_image || (p.images && p.images[0]) || '';
      var priceCents = (p.price != null) ? p.price : (p.price_min || 0);
      var priceFmt = '$' + (priceCents / 100).toFixed(2);

      var tagsStr = (Array.isArray(p.tags) ? p.tags.join(',') : (p.tags || '')).toString().toLowerCase();
      var isBlueLight = tagsStr.indexOf('blue-light') !== -1 || tagsStr.indexOf('bluelight') !== -1 || tagsStr.indexOf('blue light') !== -1;
      var blueLightBadge = isBlueLight
        ? '<span class="rp-card-bluelight-badge" aria-label="Blue light filter lens">' +
          '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
          '<circle cx="12" cy="12" r="3.5"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>' +
          '<path d="M2 12h2"/><path d="M20 12h2"/><path d="m4.93 19.07 1.41-1.41"/><path d="m17.66 6.34 1.41-1.41"/></svg>' +
          'Blue Light</span>'
        : '';

      a.innerHTML =
        '<div class="rp-product-card-img">' +
        '<span class="rp-card-new-badge" aria-label="New product">NEW</span>' +
        blueLightBadge +
        '<img src="' + imgUrl + '" alt="' + (p.title || '') + '" loading="lazy"></div>' +
        '<div class="rp-product-card-info">' +
        '<span class="rp-product-card-name">' + (p.title || '') + '</span>' +
        '<span class="rp-product-card-price">' + priceFmt + '</span>' +
        '</div>';

      return a;
    }

    if (fill()) return;
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      if (fill() || tries >= 40) clearInterval(t);
    }, 250);
  })();
</script>

{%- comment -%} === GLASSES PDP — swap Size Chart + Care for Dimensions / Frame / Care & Storage === {%- endcomment -%}
<style>
  /* Hide existing Size Chart + Care Instructions on eyewear pages */
  html[data-lgcy-eyewear] button[onclick*="'sizechart'"],
  html[data-lgcy-eyewear] #rp-acc-sizechart,
  html[data-lgcy-eyewear] button[onclick*="'care'"]:not([onclick*="'carestorage'"]),
  html[data-lgcy-eyewear] #rp-acc-care:not(#rp-acc-carestorage) {
    display: none !important;
  }

  /* Dimensions / Frame Details tables — now rendered inside .rp-tab-panel
     (see script below), which forces every descendant to a uniform gray
     500-weight style for cross-tab consistency. !important here reasserts
     the key/value contrast on top of that. */
  .lgcy-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lgcy-spec-list li {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 14px !important;
  }
  .lgcy-spec-list li:last-child {
    border-bottom: 0;
  }
  .lgcy-spec-list li .lgcy-spec-key {
    color: #666 !important;
    font-weight: 500 !important;
    letter-spacing: -0.01em;
  }
  .lgcy-spec-list li .lgcy-spec-val {
    font-weight: 800 !important;
    color: #111 !important;
    letter-spacing: -0.02em;
  }
</style>

<script>
  (function () {
    var eyewearMeta = document.querySelector('meta[name="lgcy-product-is-eyewear"]');
    if (!eyewearMeta) return;
    document.documentElement.setAttribute('data-lgcy-eyewear', '1');

    var handleMeta = document.querySelector('meta[name="lgcy-product-handle"]');
    var handle = handleMeta ? handleMeta.getAttribute('content') : '';

    /* Per-product specs. Add more handles here as new frames launch. */
    var GLASSES_DATA = {
      'lgcy-01-aeris-black-clear': {
        dimensions: [
          ['Temple Length', '145mm'],
          ['Frame Width', '133.2mm'],
          ['Lens Width', '47mm'],
          ['Lens Height', '39.8mm']
        ],
        frame: [
          ['Silhouette', 'Round'],
          ['Material', 'Premium acetate'],
          ['Bridge', '20mm'],
          ['Lens', 'Optical-grade clear · blue-light filter']
        ]
      },
      'lgcy_black-purple': {
        dimensions: [
          ['Temple Length', '145mm'],
          ['Frame Width', '133.2mm'],
          ['Lens Width', '47mm'],
          ['Lens Height', '39.8mm']
        ],
        frame: [
          ['Silhouette', 'Round'],
          ['Material', 'Premium acetate'],
          ['Bridge', '20mm'],
          ['Lens', 'Tinted purple']
        ]
      }
    };

    /* Care copy — slightly different wording from any common reference. */
    var CARE_HTML =
      '<p>Each pair ships in a hard case with a microfiber cloth. ' +
      'Keep your frames inside the case whenever they\'re not on your face.</p>' +
      '<p>Wipe lenses gently with the cloth — never use paper, alcohol, ' +
      'or household cleaners. They will scratch coatings and break down the acetate.</p>' +
      '<p>Avoid leaving your glasses in direct sun for long stretches ' +
      '(parked cars, dashboards) — sustained heat warps the frame.</p>';

    function buildList(rows) {
      var html = '<ul class="lgcy-spec-list">';
      rows.forEach(function (r) {
        html += '<li><span class="lgcy-spec-key">' + r[0] +
                '</span><span class="lgcy-spec-val">' + r[1] + '</span></li>';
      });
      html += '</ul>';
      return html;
    }

    function init() {
      var tabsNav = document.querySelector('.rp-tabs-nav');
      var tabsWrap = document.querySelector('.rp-tabs-wrap');
      if (!tabsNav || !tabsWrap) return false;
      if (document.getElementById('rp-tab-dimensions')) return true;

      var data = GLASSES_DATA[handle] || null;
      var dimHtml, frameHtml;
      if (data) {
        dimHtml = buildList(data.dimensions);
        frameHtml = buildList(data.frame);
      } else {
        dimHtml = '<p style="color:#666;">Dimensions for this frame are coming soon.</p>';
        frameHtml = '<p style="color:#666;">Frame details for this style are coming soon.</p>';
      }

      var tabs = [
        { id: 'dimensions',   title: 'Dimensions',        body: dimHtml },
        { id: 'framedetails', title: 'Frame Details',     body: frameHtml },
        { id: 'carestorage',  title: 'Care & Storage', body: CARE_HTML }
      ];

      /* Insert the new tab buttons before Shipping & Returns so the row
         reads Dimensions / Frame Details / Care & Storage / Shipping &
         Returns — same horizontal .rp-tabs-nav the sweatshirt PDP uses. */
      var shippingBtn = tabsNav.querySelector('button[onclick*="shipping"]');

      tabs.forEach(function (t, i) {
        var btn = document.createElement('button');
        btn.className = 'rp-tab-btn' + (i === 0 ? ' is-active' : '');
        btn.type = 'button';
        btn.setAttribute('onclick', "rpTabSwitch(this,'" + t.id + "')");
        btn.textContent = t.title;
        tabsNav.insertBefore(btn, shippingBtn || null);

        var panel = document.createElement('div');
        panel.className = 'rp-tab-panel' + (i === 0 ? ' is-active' : '');
        panel.id = 'rp-tab-' + t.id;
        panel.innerHTML = t.body;
        tabsWrap.appendChild(panel);
      });

      if (shippingBtn) shippingBtn.classList.remove('is-active');
      var shippingPanel = document.getElementById('rp-tab-shipping');
      if (shippingPanel) shippingPanel.classList.remove('is-active');

      return true;
    }

    if (init()) return;
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      if (init() || tries >= 40) clearInterval(t);
    }, 250);
  })();
</script>

{%- comment -%} === Coming Soon — hide Add to Cart, show a badge in its place === {%- endcomment -%}
<style>
  html:has(meta[name="lgcy-product-coming-soon"]) .rp-btn-cart {
    display: none !important;
  }

  .lgcy-coming-soon-badge {
    --border-width: 1px;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 14px;
    padding: 16px 24px;
    box-sizing: border-box;
    border-radius: 999vw;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 900;
    font-size: 13px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #000;
    background: linear-gradient(
      -75deg,
      rgba(255, 255, 255, 0.55),
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.55)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12),
      0 0.2em 0.4em -0.1em rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(0, 0, 0, 0.08);
    -webkit-backdrop-filter: blur(6px) saturate(140%);
            backdrop-filter: blur(6px) saturate(140%);
  }
  .lgcy-coming-soon-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999vw;
    width: calc(100% + var(--border-width));
    height: calc(100% + var(--border-width));
    top: calc(0% - var(--border-width) / 2);
    left: calc(0% - var(--border-width) / 2);
    padding: var(--border-width);
    box-sizing: border-box;
    background: conic-gradient(
      from -75deg at 50% 50%,
      rgba(0, 0, 0, 0.4),
      rgba(0, 0, 0, 0) 5% 40%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0) 60% 95%,
      rgba(0, 0, 0, 0.4)
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }
</style>

<script>
  (function () {
    var comingSoonMeta = document.querySelector('meta[name="lgcy-product-coming-soon"]');
    if (!comingSoonMeta) return;

    function initComingSoonBadge() {
      var btn = document.querySelector('.rp-btn-cart');
      if (!btn || !btn.parentNode) return false;
      if (document.querySelector('.lgcy-coming-soon-badge')) return true;

      var badge = document.createElement('div');
      badge.className = 'lgcy-coming-soon-badge';
      badge.textContent = 'Coming Soon';
      btn.parentNode.insertBefore(badge, btn);

      /* Belt-and-suspenders: the CSS above already hides the button, but
         block the actual form submit too in case CSS hasn't loaded yet. */
      var form = btn.closest('form');
      if (form) {
        form.addEventListener('submit', function (e) { e.preventDefault(); });
      }

      /* Both sticky add-to-cart components (lgcy-sticky-cart.liquid's
         floating popup, theme.liquid's mobile bar) check this button's
         .disabled before triggering a click on it — setting it here makes
         them both inert automatically without duplicating the handle list. */
      btn.disabled = true;
      return true;
    }

    if (initComingSoonBadge()) return;
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      if (initComingSoonBadge() || tries >= 40) clearInterval(t);
    }, 250);
  })();
</script>
{%- endif -%}
