    font-size: 22px !important;
    line-height: 1.2 !important;
  }
  .rp-price {
    font-size: 19px !important;
  }
  .rp-color-label,
  .rp-color-val {
    font-size: 13px !important;
  }
  .rp-size-label,
  .rp-size-guide,
  .rp-size-nis {
    font-size: 13px !important;
  }
  .rp-usp-text {
    font-size: 12px !important;
  }
  .rp-section-label {
    font-size: 10px !important;
    font-weight: 700 !important;
  }
  .rp-acc-trigger {
    font-size: 14px !important;
    padding: 18px 0 !important;
  }
  .rp-acc-body-inner {
    font-size: 15px !important;
    line-height: 1.7 !important;
  }
  .rp-trigger-icon {
    font-size: 24px !important;
  }
  /* Notify When Available + breadcrumb inside info column */
  .rp-info a[href*="notify"],
  .rp-info .rp-notify,
  .rp-info .rp-bread,
  .rp-info .lgcy-breadcrumb,
  .rp-info nav {
    font-size: 13px !important;
  }

  @media (max-width: 749px) {
    .rp-title {
      font-size: 20px !important;
    }
    .rp-price {
      font-size: 17px !important;
    }
    .rp-acc-trigger {
      font-size: 13px !important;
      padding: 16px 0 !important;
    }
    .rp-acc-body-inner {
      font-size: 14px !important;
    }
  }

  /* === Kill the empty gap below the product image area === */
  /* The actual culprit was Shopify's section padding on the custom_liquid
     wrapper (padding-bottom: 52px). Templates JSON is in the deploy ignore
     list so we zero it from CSS instead. */
  [class*="custom_liquid_NQgBBj-padding"] {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  /* (Injected glasses accordions get max-height set inline on creation so
     they start open — no !important rule here, otherwise rpAccToggle
     couldn't collapse them when the user clicks.) */

  .rp-usp-row:has(.rp-dot-in) .rp-usp-text,
  .rp-usp-row:has(.rp-dot-low) .rp-usp-text,
  .rp-usp-row:has(.rp-dot-out) .rp-usp-text {
    font-size: 12px !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em !important;
    color: #1a1a1a !important;
    text-transform: uppercase !important;
  }
  .rp-usp-row:has(.rp-dot-in) .rp-dot-in,
  .rp-usp-row:has(.rp-dot-low) .rp-dot-low,
  .rp-usp-row:has(.rp-dot-out) .rp-dot-out {
    width: 9px !important;
    height: 9px !important;
  }
  .rp-usp-row:has(.rp-dot-in) .rp-dot-in::before,
  .rp-usp-row:has(.rp-dot-low) .rp-dot-low::before,
  .rp-usp-row:has(.rp-dot-out) .rp-dot-out::before {
    width: 9px !important;
    height: 9px !important;
  }
  .rp-editorial {
    margin-top: 0 !important;
  }
</style>

<style>
  /* === All PDPs — turn the first ("Product Details") accordion into a
        permanently-open, shaded info box. Other accordions untouched. === */

  /* Hide the trigger header for Product Details (first trigger) */
  .rp-acc-list > .rp-acc-trigger:first-of-type {
    display: none !important;
  }

  /* Force the Product Details body permanently open */
  #rp-acc-details {
    position: relative;
    max-height: none !important;
    overflow: visible !important;
    border-bottom: 0 !important;
    margin-top: 16px;
    border-radius: 10px;
    background: #fbf8f2;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: none !important;
  }
  #rp-acc-details .rp-acc-body-inner {
    padding: 22px 24px !important;
    color: #444;
    font-size: 13px !important;
  }
  #rp-acc-details .rp-acc-body-inner p {
    margin-bottom: 10px;
  }
  #rp-acc-details .rp-acc-body-inner p:last-child {
    margin-bottom: 0;
  }
  /* Strip the redundant close × inside the open box */
  #rp-acc-details .rp-acc-close {
    display: none !important;
  }

  /* Restore the top border on the next accordion since we hid the first
     trigger that owned it */
  .rp-acc-list > .rp-acc-trigger:nth-of-type(1) + .rp-acc-body + .rp-acc-trigger {
    border-top: 1px solid #e0e0e0;
    margin-top: 24px;
  }

  @media (max-width: 860px) {
    /* Mobile beige ran a touch darker/warmer than the desktop version —
       lighten both the page background and the details box to match. */
    html body .rp-wrap,
    html body .rp-tabs-wrap {
      background: #faf6f0 !important;
    }
    #rp-acc-details {
      background: #fdfbf7;
    }
  }

  @media (max-width: 749px) {
    #rp-acc-details {
      margin-top: 2px;
      border-radius: 8px;
    }
    #rp-acc-details .rp-acc-body-inner {
      padding: 8px 18px !important;
    }
    /* The shorthand above already gives equal top/bottom padding, but the
       merchant's first description paragraph still carries its own default
       browser margin-top, which made the top look bigger than the bottom
       (where the last-child rule below already zeroes that paragraph's
       margin). Zero it here too so both sides match. */
    #rp-acc-details .rp-acc-body-inner > *:first-child {
      margin-top: 0 !important;
    }
  }
</style>

<template id="lgcy-pdp-new-template">
  <span class="lgcy-pdp-new-badge" role="note" aria-label="New product">NEW</span>
</template>

