{% comment %}
  LGCY — Trust row (3 columns) rendered below the product grid on
  collection pages. Cream background to match the hero description block,
  Inter 900 headings with negative tracking, clean stroke icons.
{% endcomment %}

<section class="lgcy-trust" aria-label="Brand promises">
  <div class="lgcy-trust__inner">

    <div class="lgcy-trust__item">
      <span class="lgcy-trust__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <path d="m14.31 9.69-1.4 4.2a.6.6 0 0 1-.38.38l-4.2 1.4 1.4-4.2a.6.6 0 0 1 .38-.38z"/>
        </svg>
      </span>
      <div class="lgcy-trust__text">
        <h3 class="lgcy-trust__title">Made With Intention</h3>
        <p class="lgcy-trust__body">Every piece adds to the story — one drop, one chapter at a time.</p>
      </div>
    </div>

    <div class="lgcy-trust__item">
      <span class="lgcy-trust__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/>
          <circle cx="7.5" cy="7.5" r="1.5"/>
        </svg>
      </span>
      <div class="lgcy-trust__text">
        <h3 class="lgcy-trust__title">Limited Quantities</h3>
        <p class="lgcy-trust__body">Every drop is made in limited runs. Once it's gone, it's gone.</p>
      </div>
    </div>

    <div class="lgcy-trust__item">
      <span class="lgcy-trust__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="10" rx="2"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
      </span>
      <div class="lgcy-trust__text">
        <h3 class="lgcy-trust__title">Secure Checkout</h3>
        <p class="lgcy-trust__body">Encrypted payment, every order protected.</p>
      </div>
    </div>

  </div>
</section>

<style>
  .lgcy-trust {
    background: #faf8f4;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 56px 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
  }
  .lgcy-trust__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
  }
  .lgcy-trust__item {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 8px 28px;
    position: relative;
  }
  .lgcy-trust__item + .lgcy-trust__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: rgba(0, 0, 0, 0.1);
  }
  .lgcy-trust__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999vw;
    background: linear-gradient(
      -75deg,
      rgba(255, 255, 255, 0.55),
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.55)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1),
      0 0.25em 0.6em -0.15em rgba(0, 0, 0, 0.15);
    color: #000;
    -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
  }
  .lgcy-trust__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .lgcy-trust__title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 900;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    font-size: 14px;
    line-height: 1.1;
    color: #000;
    margin: 0;
  }
  .lgcy-trust__body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: #6b6b6b;
    margin: 0;
  }

  @media (max-width: 990px) {
    .lgcy-trust__inner {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
    .lgcy-trust__item {
      padding: 18px 0;
    }
    .lgcy-trust__item + .lgcy-trust__item::before {
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }

  @media (max-width: 749px) {
    .lgcy-trust {
      padding: 40px 18px;
    }
    .lgcy-trust__icon {
      width: 44px;
      height: 44px;
    }
    .lgcy-trust__icon svg {
      width: 22px;
      height: 22px;
    }
    .lgcy-trust__title {
      font-size: 12px;
    }
    .lgcy-trust__body {
      font-size: 11.5px;
    }
  }
</style>
